+            bbox=cand.bbox,
+            corners=list(cand.corners),
+            plate_image=a.plate_image if a.plate_image is not None else a.rect.image,
+            elapsed_ms=0.0,
+            stage_ms={},
+            vehicle_type_hint=d.vehicle_type_hint,
+        )
