+"""CPU-only safe-set scorer for the batch-12 province readers.
+
+Scores the existing safe tune rows, the per-province holdout, and deterministic
+31x30 province-swap rows. It never reads the fixed val/devhard manifests.
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+import json
+import os
+from collections import Counter, defaultdict
+from pathlib import Path
+
+for _name in ("OMP_NUM_THREADS", "MKL_NUM_THREADS", "OPENBLAS_NUM_THREADS",
+              "BLIS_NUM_THREADS", "NUMEXPR_NUM_THREADS"):
+    os.environ[_name] = "1"
+os.environ["CUDA_VISIBLE_DEVICES"] = ""
+_ROOT = Path(__file__).resolve().parents[3]
+_RUNTIME_TMP = _ROOT / "algorithm" / "out" / "tmp" / "batch12-runtime"
+_RUNTIME_TMP.mkdir(parents=True, exist_ok=True)
+os.environ["TEMP"] = str(_RUNTIME_TMP)
+os.environ["TMP"] = str(_RUNTIME_TMP)
+
+
+def _rows(path: Path):
+    with path.open(encoding="utf-8-sig", newline="") as stream:
+        yield from csv.DictReader(stream)
+
+
+def _quad(text: str):
+    values = [float(value) for value in text.replace(",", " ").split()]
+    if len(values) != 8:
+        raise ValueError("quad must contain eight ordered coordinates")
+    return [(values[i], values[i + 1]) for i in range(0, 8, 2)]
+
+
+def _image(path: Path, cv2, np):
+    data = np.fromfile(path, dtype=np.uint8)
+    image = cv2.imdecode(data, cv2.IMREAD_COLOR)
+    if image is None or image.dtype != np.uint8 or image.ndim != 3:
+        raise ValueError(f"cannot decode source image: {path}")
+    return image
+
+
+def _rectified(image, quad, width, cv2):
+    import numpy as np
+    target = np.float32([[0, 0], [width - 1, 0], [width - 1, 79], [0, 79]])
+    matrix = cv2.getPerspectiveTransform(np.float32(quad), target)
+    result = cv2.warpPerspective(image, matrix, (width, 80))
+    if result is None or result.size == 0:
+        raise ValueError("empty GT rectification")
+    return result
+
+
+def _first_char_patch(normalizer, image, quad, full_label: str):
+    """Preserve plate length/color context while preparing the province glyph."""
+    return normalizer(image, quad, full_label)
+
+
+def _metrics(rows):
+    province_correct = sum(row["province_correct"] for row in rows)
+    plate_correct = sum(row["plate_correct"] for row in rows if row["plate_correct"] is not None)
+    plate_n = sum(row["plate_correct"] is not None for row in rows)
+    count = len(rows)
+    return {
+        "n": count,
+        "province_correct": province_correct,
+        "province_accuracy": province_correct / count if count else None,
+        "correct": plate_correct if plate_n else province_correct,
+        "plate_n": plate_n,
+        "plate_correct": plate_correct if plate_n else None,
+        "plate_accuracy": plate_correct / plate_n if plate_n else None,
+        "predicted_皖": sum(row["predicted_province"] == "皖" for row in rows),
+        "read_as_皖_wrong": sum(row["predicted_province"] == "皖" and not row["province_correct"] for row in rows),
+    }
+
+
+def score(kind: str, model_path: Path, data_dir: Path, output: Path | None = None):
+    import cv2
+    import numpy as np
+    import torch
+    from lpr.charset import CHARSET, CHAR_TO_INDEX, PROVINCES
+    from lpr.boxcrop import crop_box
+    from lpr.recognize import load_box_reader, load_classifier, load_plate_reader
+    from lpr.recognize.crnn import CrnnNet, CrnnReader
+    from lpr.recognize.cnn_model import CharCNN
+    from lpr.recognize.box_reader import BoxPlateReader, model_from_checkpoint
+    from lpr_tools.train.province_synth import replace_province
+    from lpr_tools.train.province_char_input import normalized_first_char
+
+    if kind not in {"box", "crnn", "char"}:
+        raise ValueError("kind must be box, crnn, or char")
+    torch.set_num_threads(2)
+    cv2.setNumThreads(1)
+    saved = torch.load(model_path, map_location="cpu", weights_only=True)
+    if isinstance(saved, dict) and saved.get("format") == "province-reader-training-v1":
+        if saved.get("kind") != kind:
+            raise ValueError("training checkpoint kind does not match --kind")
+        weights = saved.get("model_state")
+    else:
+        weights = saved
+    if kind == "box":
+        if weights is saved:
+            reader = load_box_reader(model_path)
+        else:
+            model = model_from_checkpoint(weights)
+            reader = BoxPlateReader("batch12-selection", model,
+                                    temperature=weights["temperature"],
+                                    box_pad=tuple(weights["box_pad"]))
+        pad_x, pad_y = reader.box_pad
+        province_reader = None
+    elif kind == "crnn":
+        if weights is saved:
+            reader = load_plate_reader(model_path)
+        else:
+            state = dict(weights)
+            temperature = state.pop("ctc_temperature", torch.tensor(1.0))
+            if temperature.ndim != 0 or not torch.isfinite(temperature):
+                raise ValueError("CRNN checkpoint temperature must be a finite scalar")
+            model = CrnnNet()
+            model.load_state_dict(state, strict=True)
+            reader = CrnnReader("batch12-selection", model, temperature=float(temperature.item()))
+        province_reader = None
+    else:
+        if weights is saved:
+            province_reader = load_classifier("cnn", model_path)
+        else:
+            model = CharCNN()
+            model.load_state_dict(weights, strict=True)
+            from lpr.recognize.cnn import CnnClassifier
+            province_reader = CnnClassifier("batch12-selection", model)
+        reader = None
+
+    root = Path(data_dir)
+    tune_path = root / "tune.csv"
+    if not tune_path.exists():
+        tune_path = root.parent / "batch11" / "tune.csv"
+    sources = []
+    for filename, mode in ((tune_path, "real"), (root / "province_holdout.csv", "real"),
+                           (root / "synth_eval.csv", "synthetic")):
+        if filename.exists():
+            for raw in _rows(filename):
+                row = dict(raw)
+                row["_mode"] = mode
+                row["_panel"] = ("synthetic" if filename.name == "synth_eval.csv" else
+                                 "province_holdout" if filename.name == "province_holdout.csv" else "tune")
+                row["_source_file"] = str(filename.resolve())
+                row["target_province"] = row.get("target_province") or row.get("province") or row["label"][0]
+                sources.append(row)
+    if not sources:
+        raise FileNotFoundError(f"no tune/holdout/synth evaluation rows in {root}")
+
+    grouped = defaultdict(list)
+    all_rows = []
+    for row in sources:
+        image = _image(Path(row["path"]), cv2, np)
+        quad = _quad(row["quad"])
+        truth = row["label"]
+        if row["_mode"] == "synthetic":
+            seed = int(row.get("seed") or 0)
+            image, truth, _meta = replace_province(
+                image, quad, truth, row["target_province"], np.random.default_rng(seed))
+        if not truth or truth[0] not in CHAR_TO_INDEX:
+            raise ValueError(f"illegal province label: {truth!r}")
+        if kind == "char":
+            patch = _first_char_patch(normalized_first_char, image, quad, truth)
+            if not isinstance(patch, np.ndarray) or patch.dtype != np.uint8 or patch.shape != (32, 32):
+                raise ValueError("normalized_first_char must return uint8 32 x 32")
+            probabilities = province_reader.predict_proba(patch[None, ...])[0]
+            province_indices = [CHAR_TO_INDEX[c] for c in PROVINCES]
+            province_pred = CHARSET[province_indices[int(np.argmax(probabilities[province_indices]))]]
+            plate_pred = None
+        else:
+            if kind == "box":
+                xs, ys = [p[0] for p in quad], [p[1] for p in quad]
+                bbox = (min(xs), min(ys), max(xs)-min(xs), max(ys)-min(ys))
+                crop = crop_box(image, bbox, pad_x, pad_y)
+                plate_pred, confidences = reader.read(crop)
+            else:
+                width = 276 if len(truth) == 8 else 252
+                crop = _rectified(image, quad, width, cv2)
+                plate_pred, confidences = reader.read(crop)
+            province_pred = plate_pred[0] if plate_pred else ""
+        record = {
+            "path": row["path"], "source": row["_source_file"], "mode": row["_mode"],
+            "panel": row["_panel"],
+            "province": truth[0], "predicted_province": province_pred,
+            "province_correct": province_pred == truth[0],
+            "plate_correct": None if plate_pred is None else plate_pred == truth,
+            "prediction": plate_pred, "subset": row.get("subset"),
+            "brightness": row.get("brightness"), "synthetic_target": row.get("target_province") if row["_mode"] == "synthetic" else None,
+        }
+        all_rows.append(record)
+        grouped[row["_mode"]].append(record)
+        grouped["panel/" + row["_panel"]].append(record)
+        grouped["panel_province/" + row["_panel"] + "/" + truth[0]].append(record)
+        grouped["province/" + truth[0]].append(record)
+        if record["subset"]:
+            grouped["subset/" + record["subset"]].append(record)
+
+    overall = _metrics(all_rows)
+    metrics = {"overall": overall, **{key: _metrics(rows) for key, rows in sorted(grouped.items())}}
+    plate_accuracy = overall["plate_accuracy"]
+    selection_score = overall["province_accuracy"] if plate_accuracy is None else (
+        overall["province_accuracy"] + plate_accuracy) / 2
+    result = {
+        "schema": "batch12-province-reader-score-v1", "kind": kind,
+        "model": str(model_path.resolve()), "data_dir": str(root.resolve()),
+        "selection_score": selection_score,
+        "province_accuracy": overall["province_accuracy"],
+        "plate_accuracy": plate_accuracy,
+        "correct": overall["correct"], "n": overall["n"],
+        "metrics": metrics,
+        "read_as_皖_wrong": overall["read_as_皖_wrong"],
+        "selection_rule": "safe tune + province holdout + deterministic synthetic panel; plate readers average province and full-plate accuracy; char CNN uses province accuracy restricted to PROVINCE_IDX",
+        "sources": sorted({row["source"] for row in all_rows}),
+        "excluded_fixed_val_dev": True,
+        "records": all_rows,
+    }
+    if output is not None:
+        output.parent.mkdir(parents=True, exist_ok=True)
+        output.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    return result
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--kind", choices=("box", "crnn", "char"), required=True)
+    parser.add_argument("--model", type=Path, required=True)
+    parser.add_argument("--data-dir", type=Path, default=Path("algorithm/out/data/batch12"))
+    parser.add_argument("--out", type=Path)
+    args = parser.parse_args(argv)
+    result = score(args.kind, args.model, args.data_dir, args.out)
+    print(json.dumps({key: result[key] for key in (
+        "selection_score", "province_accuracy", "plate_accuracy", "correct", "n",
+        "kind", "read_as_皖_wrong")}, ensure_ascii=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/algorithm/lpr_tools/train/synth_chars.py b/algorithm/lpr_tools/train/synth_chars.py
new file mode 100644
index 0000000..4f6ab2a
--- /dev/null
+++ b/algorithm/lpr_tools/train/synth_chars.py
@@ -0,0 +1,145 @@
+"""Generate a font-only smoke dataset; its accuracy is not CCPD acceptance."""
+
+import argparse
+import csv
+from pathlib import Path
+
+import cv2
+import numpy as np
+from PIL import Image, ImageDraw, ImageFont
+
+from lpr.charset import CHARSET, CHAR_TO_INDEX, PROVINCES
+from lpr.charnorm import normalize_char, unify_polarity
+from lpr.io_utils import imwrite
+from .augment import augment_char
+
+DEFAULT_FONT = Path("C:/Windows/Fonts/simhei.ttf")
+# RGB plate backgrounds and text; conversion to gray is explicit below.
+PALETTES = {
+    "blue": ((20, 65, 180), (245, 245, 245)),
+    "yellow": ((235, 195, 25), (15, 15, 15)),
+    "green": ((130, 220, 150), (15, 15, 15)),
+    "white": ((235, 235, 235), (15, 15, 15)),
+    "black": ((20, 20, 20), (240, 240, 240)),
+}
+
+
+def render_char(char: str, font: ImageFont.FreeTypeFont, color: str) -> np.ndarray:
+    """Render tightly cropped glyph with a small plate-colored margin."""
+    left, top, right, bottom = font.getbbox(char)
+    background, foreground = PALETTES[color]
+    image = Image.new("RGB", (right - left + 8, bottom - top + 8), background)
+    ImageDraw.Draw(image).text((4 - left, 4 - top), char, font=font, fill=foreground)
+    gray = cv2.cvtColor(np.asarray(image), cv2.COLOR_RGB2GRAY)
+    return normalize_char(unify_polarity(gray, color))
+
+
+def generate_dataset(out: Path, *, per_class: int = 200, seed: int = 42,
+                     font_path: Path = DEFAULT_FONT, val_fraction: float = 0.2,
+                     provinces_only: bool = False, train_only: bool = False,
+                     labels: list[int | str] | None = None,
+                     class_counts: dict[int | str, int] | None = None) -> list[dict]:
+    """Generate selected font samples; per_class counts train+val unless train_only."""
+    out = Path(out)
+    if per_class < (1 if train_only else 2) or (not train_only and not 0 < val_fraction < 1):
+        raise ValueError("per_class must be >=1 for train-only or >=2 with 0 < val_fraction < 1")
+    if provinces_only and labels is not None:
+        raise ValueError("--provinces-only and explicit labels cannot be combined")
+    selected = list(range(len(PROVINCES))) if provinces_only else (
+        list(range(len(CHARSET))) if labels is None else [_resolve_label(label) for label in labels])
+    if not selected or len(set(selected)) != len(selected):
+        raise ValueError("labels must be a non-empty set without duplicates")
+    counts_by_label = {_resolve_label(label): int(count) for label, count in (class_counts or {}).items()}
+    if set(counts_by_label) - set(selected):
+        raise ValueError("class_counts can only override selected labels")
+    for label in selected:
+        count = counts_by_label.get(label, per_class)
+        if count < (1 if train_only else 2):
+            raise ValueError(f"sample count for {CHARSET[label]} must be >=1 for train-only or >=2 otherwise")
+    if out.exists() and any(out.iterdir()):
+        raise ValueError(f"output directory must be empty: {out}")
+    # Fail before producing a partial dataset if the requested font is unavailable.
+    font = ImageFont.truetype(str(font_path), 48)
+    out.mkdir(parents=True, exist_ok=True)
+    split_seeds = np.random.SeedSequence(seed).spawn(2)
+    rows = []
+    splits = ("train",) if train_only else ("train", "val")
+    split_seed_by_name = dict(zip(("train", "val"), split_seeds))
+    for split in splits:
+        split_seed = split_seed_by_name[split]
+        rng = np.random.default_rng(split_seed)
+        for label in selected:
+            char = CHARSET[label]
+            total = counts_by_label.get(label, per_class)
+            val_count = 0 if train_only else max(1, min(total - 1, round(total * val_fraction)))
+            count = total if train_only else (total - val_count if split == "train" else val_count)
+            for index in range(count):
+                color = str(rng.choice(list(PALETTES)))
+                image = augment_char(render_char(char, font, color), rng)
+                relative = Path(split) / str(label) / f"{index:05d}.png"
+                imwrite(out / relative, image)
+                rows.append({"path": relative.as_posix(), "split": split, "label": label,
+                             "char": char, "plate_color": color, "source": "font_synthetic",
+                             "font": str(font_path), "seed": seed})
+    with (out / "chars_index.csv").open("w", encoding="utf-8", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=["path", "split", "label", "char", "plate_color",
+                                                    "source", "font", "seed"])
+        writer.writeheader()
+        writer.writerows(rows)
+    print("label char train val total")
+    total_train = total_val = total_all = 0
+    for label in selected:
+        char = CHARSET[label]
+        total = counts_by_label.get(label, per_class)
+        val_count = 0 if train_only else max(1, min(total - 1, round(total * val_fraction)))
+        train_count = total if train_only else total - val_count
+        total_train += train_count; total_val += val_count; total_all += total
+        print(f"{label:2d} {char} {train_count:5d} {val_count:3d} {total:5d}")
+    print(f"TOTAL train={total_train} val={total_val} total={total_all}")
+    return rows
+
+
+def _resolve_label(value: int | str) -> int:
+    if isinstance(value, int):
+        label = value
+    else:
+        raw = str(value)
+        label = int(raw) if raw.isdecimal() else CHAR_TO_INDEX.get(raw, -1)
+    if not 0 <= label < len(CHARSET):
+        raise ValueError(f"unknown character label: {value}")
+    return label
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--per-class", type=int, default=200)
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--font", type=Path, default=DEFAULT_FONT)
+    parser.add_argument("--val-fraction", type=float, default=0.2)
+    parser.add_argument("--provinces-only", action="store_true",
+                        help="generate only the 31 province labels")
+    parser.add_argument("--train-only", action="store_true",
+                        help="write all samples under train; do not create validation samples")
+    parser.add_argument("--labels", nargs="+", metavar="LABEL",
+                        help="selected label characters or charset indexes (for example 陕 26)")
+    parser.add_argument("--class-count", action="append", default=[], metavar="LABEL=COUNT",
+                        help="override this label's total sample count; repeat as needed")
+    args = parser.parse_args()
+    class_counts = {}
+    for item in args.class_count:
+        if "=" not in item:
+            parser.error(f"--class-count must be LABEL=COUNT: {item}")
+        label, count = item.split("=", 1)
+        try:
+            class_counts[label] = int(count)
+        except ValueError:
+            parser.error(f"--class-count must have an integer count: {item}")
+    generate_dataset(args.out, per_class=args.per_class, seed=args.seed,
+                     font_path=args.font, val_fraction=args.val_fraction,
+                     provinces_only=args.provinces_only, train_only=args.train_only,
+                     labels=args.labels, class_counts=class_counts)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/algorithm/lpr_tools/train/synth_plates.py b/algorithm/lpr_tools/train/synth_plates.py
new file mode 100644
index 0000000..56381e8
--- /dev/null
+++ b/algorithm/lpr_tools/train/synth_plates.py
@@ -0,0 +1,187 @@
+"""Generate a reproducible, font-only, train-only rare-province plate set."""
+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+import json
+from functools import lru_cache
+from collections import Counter
+from pathlib import Path
+
+import cv2
+import numpy as np
+from PIL import Image, ImageDraw, ImageFont
+
+from lpr.charset import DIGITS, LETTERS, PROVINCES
+from lpr.plate_rules import match_layout
+
+DEFAULT_FONT = Path("C:/Windows/Fonts/simhei.ttf")
+FIELDS = ("file", "plate_no", "layout", "color", "source", "orig_path")
+BLUE_BG, BLUE_FG = (32, 74, 174), (247, 248, 246)
+GREEN_BG, GREEN_FG = (142, 205, 139), (17, 33, 25)
+LAYOUT_CENTERS = {
+    7: (0.075397, 0.204365, 0.380952, 0.507937, 0.636905, 0.763889, 0.894841),
+    8: (0.076087, 0.193841, 0.378623, 0.489130, 0.599638, 0.710145, 0.818841, 0.927536),
+}
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+@lru_cache(maxsize=128)
+def _font(path: str, size: int) -> ImageFont.FreeTypeFont:
+    return ImageFont.truetype(path, size)
+
+
+def _plate_number(province: str, rng: np.random.Generator, layout: int) -> str:
+    prefix = province + str(rng.choice(LETTERS))
+    if layout == 7:
+        plate = prefix + "".join(rng.choice(np.asarray(list(DIGITS + LETTERS)), size=5).tolist())
+    elif rng.random() < .5:
+        plate = prefix + str(rng.choice(tuple("DF"))) + str(rng.choice(DIGITS + LETTERS))
+        plate += "".join(rng.choice(np.asarray(list(DIGITS)), size=4).tolist())
+    else:
+        plate = prefix + "".join(rng.choice(np.asarray(list(DIGITS)), size=5).tolist())
+        plate += str(rng.choice(tuple("DF")))
+    if match_layout(plate) is None:
+        raise AssertionError(f"generated invalid plate: {plate}")
+    return plate
+
+
+def _render(text: str, layout: int, font_paths: tuple[Path, ...], rng: np.random.Generator) -> np.ndarray:
+    width = 252 if layout == 7 else 276
+    background, foreground = (BLUE_BG, BLUE_FG) if layout == 7 else (GREEN_BG, GREEN_FG)
+    canvas = Image.new("RGB", (width, 80), background)
+    font_path = font_paths[int(rng.integers(len(font_paths)))]
+    centers = np.asarray(LAYOUT_CENTERS[layout]) * width
+    for index, (char, center) in enumerate(zip(text, centers)):
+        glyph_h = int(rng.integers(49, 63))
+        glyph_w = int(rng.integers(25, 31)) if index == 0 else int(rng.integers(20, 28))
+        font = _font(str(font_path), glyph_h + 18)
+        box = font.getbbox(char)
+        mask = Image.new("L", (box[2] - box[0] + 8, box[3] - box[1] + 8), 0)
+        ImageDraw.Draw(mask).text((4 - box[0], 4 - box[1]), char, font=font, fill=255)
+        cropped = mask.crop(mask.getbbox()).resize((glyph_w, glyph_h), Image.Resampling.LANCZOS)
+        x = round(center - glyph_w / 2 + rng.uniform(-1.25, 1.25))
+        y = round(40 - glyph_h / 2 + rng.uniform(-2.0, 2.0))
+        canvas.paste(foreground, (x, y), cropped)
+
+    image = cv2.cvtColor(np.asarray(canvas), cv2.COLOR_RGB2BGR)
+    # Mild print/capture variation, bounded to avoid changing character identity.
+    angle = float(rng.uniform(-1.5, 1.5))
+    matrix = cv2.getRotationMatrix2D((width / 2, 40), angle, float(rng.uniform(.97, 1.03)))
+    matrix[0, 2] += float(rng.uniform(-2, 2))
+    matrix[1, 2] += float(rng.uniform(-1.5, 1.5))
+    image = cv2.warpAffine(image, matrix, (width, 80), borderMode=cv2.BORDER_REPLICATE)
+    if rng.random() < .3:
+        source = np.float32([[0, 0], [width - 1, 0], [width - 1, 79], [0, 79]])
+        jitter = rng.uniform(-2.0, 2.0, (4, 2)).astype(np.float32)
+        perspective = cv2.getPerspectiveTransform(source, source + jitter)
+        image = cv2.warpPerspective(image, perspective, (width, 80), borderMode=cv2.BORDER_REPLICATE)
+    if rng.random() < .25:
+        image = cv2.GaussianBlur(image, (3, 3), float(rng.uniform(.2, .8)))
+    image = np.clip(image.astype(np.float32) * rng.uniform(.88, 1.12) + rng.uniform(-12, 12), 0, 255).astype(np.uint8)
+    if rng.random() < .35:
+        noise = rng.normal(0, rng.uniform(1, 5), image.shape).astype(np.float32)
+        image = np.clip(image.astype(np.float32) + noise, 0, 255).astype(np.uint8)
+    if rng.random() < .08:
+        x = int(rng.integers(8, width - 12)); y = int(rng.integers(8, 70))
+        cv2.line(image, (x, y), (min(width - 1, x + int(rng.integers(3, 9))), y),
+                 color=(112, 112, 112) if layout == 7 else (85, 110, 85), thickness=1)
+    return image
+
+
+def generate_dataset(out: Path, *, real_labels: Path, min_per_province: int = 1500,
+                     seed: int = 42, font_paths: tuple[Path, ...] | None = None) -> dict:
+    """Fill every province with <1000 real train rows to min_per_province total.
+
+    The output contains only a ``train`` directory. Synthetic labels never enter val.
+    """
+    out, real_labels = Path(out), Path(real_labels)
+    if min_per_province < 1000:
+        raise ValueError("min_per_province must be at least 1000")
+    if out.exists() and any(out.iterdir()):
+        raise ValueError(f"output directory must be empty: {out}")
+    fonts = tuple(font_paths or (DEFAULT_FONT, Path("C:/Windows/Fonts/simkai.ttf"),
+                                 Path("C:/Windows/Fonts/simfang.ttf")))
+    if not fonts or any(not path.is_file() for path in fonts):
+        raise FileNotFoundError("all configured font files must exist")
+    # Preflight every font and every target glyph before creating output files.
+    for path in fonts:
+        font = _font(str(path), 32)
+        if any(font.getbbox(char) is None for char in PROVINCES + list(DIGITS) + list(LETTERS)):
+            raise ValueError(f"font lacks a required plate glyph: {path}")
+    with real_labels.open(encoding="utf-8-sig", newline="") as stream:
+        reader = csv.DictReader(stream)
+        if tuple(reader.fieldnames or ()) != FIELDS:
+            raise ValueError(f"real labels schema must be {FIELDS}")
+        counts = Counter()
+        for row in reader:
+            if row["source"] == "ground_truth" and row["file"].startswith("train/"):
+                if row["plate_no"] and row["plate_no"][0] in PROVINCES:
+                    counts[row["plate_no"][0]] += 1
+    rare = {province: max(0, min_per_province - counts[province])
+            for province in PROVINCES if counts[province] < 1000}
+    if out.exists() and not out.is_dir():
+        raise ValueError(f"output path is not a directory: {out}")
+    (out / "train").mkdir(parents=True, exist_ok=True)
+    rng = np.random.default_rng(seed)
+    rows: list[dict[str, str | int]] = []
+    synthetic_counts = Counter()
+    for province, needed in rare.items():
+        for number in range(needed):
+            layout = 8 if rng.random() < .22 else 7
+            color = "green" if layout == 8 else "blue"
+            plate_no = _plate_number(province, rng, layout)
+            image = _render(plate_no, layout, fonts, rng)
+            payload = cv2.imencode(".png", image)[1].tobytes()
+            name = hashlib.sha256(f"{seed}\0{province}\0{number}\0{plate_no}".encode()).hexdigest() + ".png"
+            relative = f"train/{name}"
+            (out / relative).write_bytes(payload)
+            rows.append({"file": relative, "plate_no": plate_no, "layout": layout,
+                         "color": color, "source": "font_synthetic", "orig_path": ""})
+            synthetic_counts[province] += 1
+    with (out / "labels.csv").open("w", encoding="utf-8", newline="") as stream:
+        writer = csv.DictWriter(stream, fieldnames=FIELDS)
+        writer.writeheader()
+        writer.writerows(rows)
+    metadata = {
+        "generator": "lpr_tools.train.synth_plates",
+        "seed": seed,
+        "train_only": True,
+        "min_per_province_including_real_train": min_per_province,
+        "real_labels_sha256": _sha256(real_labels),
+        "fonts": [{"path": str(path), "sha256": _sha256(path)} for path in fonts],
+        "rare_provinces_real_train_ground_truth": {p: counts[p] for p in rare},
+        "synthetic_train_by_province": dict(synthetic_counts),
+        "synthetic_train_by_layout_color": {
+            "7/blue": sum(row["layout"] == 7 for row in rows),
+            "8/green": sum(row["layout"] == 8 for row in rows),
+        },
+        "rows": len(rows),
+        "labels_sha256": _sha256(out / "labels.csv"),
+    }
+    (out / "synthetic_manifest.json").write_text(json.dumps(metadata, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    return metadata
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--real-labels", type=Path, required=True)
+    parser.add_argument("--min-per-province", type=int, default=1500)
+    parser.add_argument("--seed", type=int, default=42)
+    args = parser.parse_args()
+    print(json.dumps(generate_dataset(args.out, real_labels=args.real_labels,
+                                      min_per_province=args.min_per_province, seed=args.seed),
+                     ensure_ascii=False, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/algorithm/lpr_tools/train/train_box_reader.py b/algorithm/lpr_tools/train/train_box_reader.py
new file mode 100644
index 0000000..91c617d
--- /dev/null
+++ b/algorithm/lpr_tools/train/train_box_reader.py
@@ -0,0 +1,417 @@
+"""Full-epoch direct-box training, bounded crop cache and explicit CPU/GPU CLI.
+
+CSV rows are mmap-indexed rather than copied into workers. Cache JPEGs retain
+original spatial resolution; a jitter needing pixels outside the cache falls
+back to the original image, never silently truncates the requested crop.
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import ctypes
+import json
+import math
+import mmap
+import os
+import random
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import cv2
+import numpy as np
+import torch
+from torch import nn
+from torch.utils.data import DataLoader, Dataset
+
+from lpr.boxcrop import crop_box
+from lpr.charset import CHAR_TO_INDEX, NUM_CLASSES
+from lpr.recognize import file_sha256
+from lpr.recognize.box_reader import BOX_PAD, INPUT_SIZE, BoxNet, box_tensor, checkpoint
+from lpr.recognize.crnn import _greedy_decode
+from lpr_tools.train.box_data import bbox_from_quad, iter_rows, jitter_bbox, sample_jitter
+
+
+def free_ram_bytes() -> int:
+    if os.name != "nt":
+        import psutil
+        return psutil.virtual_memory().available
+    class Status(ctypes.Structure):
+        _fields_ = [("length", ctypes.c_ulong), ("load", ctypes.c_ulong),
+                    *[(key, ctypes.c_ulonglong) for key in
+                      ("total", "available", "page_total", "page_available", "virtual_total",
+                       "virtual_available", "extended")]]
+    status = Status()
+    status.length = ctypes.sizeof(status)
+    if not ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(status)):
+        raise OSError("GlobalMemoryStatusEx failed")
+    return int(status.available)
+
+
+def process_ram_bytes(*, peak: bool = False) -> int:
+    # workers=0, so the training interpreter owns all substantial working memory.
+    # The launcher also records its small redirector and PowerShell parent externally.
+    if os.name != "nt":
+        import resource
+        return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024
+    class Counters(ctypes.Structure):
+        _fields_ = [("cb", ctypes.c_ulong), ("faults", ctypes.c_ulong),
+                    *[(key, ctypes.c_size_t) for key in
+                      ("peak_rss", "rss", "peak_paged", "paged", "peak_nonpaged", "nonpaged",
+                       "pagefile", "peak_pagefile", "private")]]
+    counters = Counters()
+    counters.cb = ctypes.sizeof(counters)
+    if not ctypes.windll.psapi.GetProcessMemoryInfo(
+            ctypes.c_void_p(-1), ctypes.byref(counters), counters.cb):
+        raise OSError("GetProcessMemoryInfo failed")
+    return int(counters.peak_rss if peak else counters.rss)
+
+
+def read_image(path: str | Path) -> np.ndarray:
+    image = cv2.imdecode(np.fromfile(path, np.uint8), cv2.IMREAD_COLOR)
+    if image is None:
+        raise ValueError(f"unreadable image: {path}")
+    return image
+
+
+def prepare_cache(pool: Path, cache: Path, *, limit: int = 2_800_000_000) -> dict:
+    """A single resumable temporary cache; no plate rectification or rescaling."""
+    cache.mkdir(parents=True, exist_ok=True)
+    index = cache / "index.csv"
+    fields = ("path", "label", "subset", "brightness", "sha256", "quad", "cache_file",
+              "x0", "y0", "orig_w", "orig_h")
+    used = sum(p.stat().st_size for p in cache.rglob("*.jpg"))
+    count = 0
+    started = time.perf_counter()
+    temporary = cache / "index.partial.csv"
+    with temporary.open("w", encoding="utf-8", newline="") as stream:
+        writer = csv.DictWriter(stream, fieldnames=fields)
+        writer.writeheader()
+        for row in iter_rows(pool):
+            source = read_image(row["path"])
+            bbox = bbox_from_quad(row["quad"])
+            x, y, width, height = bbox
+            x0, y0 = max(0, math.floor(x - .5 * width)), max(0, math.floor(y - .5 * height))
+            crop = crop_box(source, bbox, .5, .5)
+            if not crop.size:
+                raise ValueError(f"empty cache crop: {row['path']}")
+            target = cache / row["sha256"][:2] / (row["sha256"] + ".jpg")
+            if not target.exists():
+                success, encoded = cv2.imencode(".jpg", crop, [cv2.IMWRITE_JPEG_QUALITY, 90])
+                if not success or used + encoded.nbytes > limit:
+                    raise RuntimeError("crop cache would exceed 3 GB; shrink audited pool first")
+                target.parent.mkdir(parents=True, exist_ok=True)
+                encoded.tofile(target)
+                used += encoded.nbytes
+            record = {key: row[key] for key in fields[:6]}
+            record.update(cache_file=str(target.resolve()), x0=x0, y0=y0,
+                          orig_w=source.shape[1], orig_h=source.shape[0])
+            writer.writerow(record)
+            count += 1
+            if count % 5000 == 0:
+                stream.flush()
+                print(json.dumps({"cache_count": count, "jpeg_bytes": used,
+                                  "seconds": time.perf_counter() - started}), flush=True)
+    temporary.replace(index)
+    report = {"pool_sha256": file_sha256(pool), "cache_index_sha256": file_sha256(index),
+              "cache_path": str(cache.resolve()), "samples": count, "jpeg_bytes": used,
+              "seconds": time.perf_counter() - started, "quality": 90,
+              "scale": "original resolution", "gt_bbox_pad": [.5, .5]}
+    (cache / "audit.json").write_text(json.dumps(report, indent=2), encoding="utf-8")
+    return report
+
+
+def cache_contains(row: dict, bbox: tuple, pad: tuple, cached_shape: tuple) -> bool:
+    x, y, w, h = bbox
+    x0, y0 = int(row["x0"]), int(row["y0"])
+    left, top = max(0, math.floor(x-pad[0]*w)), max(0, math.floor(y-pad[1]*h))
+    right = min(int(row["orig_w"]), math.ceil(x+w+pad[0]*w))
+    bottom = min(int(row["orig_h"]), math.ceil(y+h+pad[1]*h))
+    return left >= x0 and top >= y0 and right <= x0+cached_shape[1] and bottom <= y0+cached_shape[0]
+
+
+def row_crop(row: dict, bbox: tuple, pad: tuple = BOX_PAD, *,
+             cached_image: np.ndarray | None = None, gpu_fallback: bool = False) -> np.ndarray:
+    if cached_image is not None:
+        if cache_contains(row, bbox, pad, cached_image.shape):
+            x, y, w, h = bbox
+            return crop_box(cached_image, (x-int(row["x0"]), y-int(row["y0"]), w, h), *pad)
+    if row.get("cache_file"):
+        source = read_image(row["cache_file"])
+        if cache_contains(row, bbox, pad, source.shape):
+            x, y, w, h = bbox
+            return crop_box(source, (x-int(row["x0"]), y-int(row["y0"]), w, h), *pad)
+    if gpu_fallback:
+        from torchvision.io import ImageReadMode, decode_jpeg, read_file
+        from lpr_tools.train.gpu_box_batches import rgb_region_for_box
+        rgb = decode_jpeg(read_file(row["path"]), mode=ImageReadMode.RGB, device="cuda")
+        source, local = rgb_region_for_box(rgb, bbox, bbox_from_quad(row["quad"]), pad)
+        return crop_box(source, local, *pad)
+    return crop_box(read_image(row["path"]), bbox, *pad)
+
+
+class BoxDataset(Dataset):
+    def __init__(self, index: Path, samples: dict, *, training: bool, seed: int = 42,
+                 gpu_fallback: bool = False) -> None:
+        self.path = Path(index)
+        self.samples, self.training, self.seed, self.epoch = samples, training, seed, 0
+        self.gpu_fallback = gpu_fallback
+        offsets = []
+        with self.path.open("rb") as stream:
+            self.header = next(csv.reader([stream.readline().decode("utf-8-sig").strip()]))
+            while True:
+                position = stream.tell()
+                if not stream.readline():
+                    break
+                offsets.append(position)
+        self.offsets = np.asarray(offsets, dtype=np.int64)
+        self._file = self._map = None
+        if not len(self.offsets):
+            raise ValueError("empty box index")
+
+    def __len__(self):
+        return len(self.offsets)
+
+    def row(self, index: int) -> dict:
+        if self._map is None:
+            self._file = self.path.open("rb")
+            self._map = mmap.mmap(self._file.fileno(), 0, access=mmap.ACCESS_READ)
+        self._map.seek(int(self.offsets[index]))
+        values = next(csv.reader([self._map.readline().decode("utf-8").strip()]))
+        return dict(zip(self.header, values))
+
+    def __getstate__(self):
+        state = self.__dict__.copy()
+        state["_file"] = state["_map"] = None
+        return state
+
+    def specification(self, index: int):
+        row = self.row(index)
+        rng = random.Random(self.seed + self.epoch*1_000_003 + index)
+        bbox = bbox_from_quad(row["quad"])
+        if self.training and rng.random() < .65:
+            bbox = jitter_bbox(bbox, sample_jitter(rng, row["subset"], self.samples))
+        return row, rng, bbox
+
+    def finish(self, image: np.ndarray, row: dict, index: int, rng: random.Random):
+        if not image.size:
+            raise ValueError(f"measured jitter produced empty crop: {row['path']}")
+        if self.training:
+            # Mild photometric variation leaves the actual dark/tilt geometry intact.
+            if rng.random() < .4:
+                gamma = rng.uniform(.65, 1.5)
+                lut = np.asarray([255*(v/255.)**gamma for v in range(256)], np.uint8)
+                image = cv2.LUT(image, lut)
+            if rng.random() < .15:
+                image = cv2.GaussianBlur(image, (3, 3), rng.uniform(.2, 1.))
+        return box_tensor(image), row["label"], index
+
+    def __getitem__(self, index: int):
+        row, rng, bbox = self.specification(index)
+        image = row_crop(row, bbox, gpu_fallback=self.gpu_fallback)
+        return self.finish(image, row, index, rng)
+
+
+def collate(rows):
+    images, labels, indices = zip(*rows)
+    targets = torch.tensor([CHAR_TO_INDEX[c] for label in labels for c in label], dtype=torch.long)
+    lengths = torch.tensor([len(label) for label in labels], dtype=torch.long)
+    return torch.stack(images), targets, lengths, list(labels), list(indices)
+
+
+def evaluate(model: BoxNet, loader: DataLoader, device: torch.device) -> dict:
+    model.eval()
+    correct = count = 0
+    with torch.inference_mode():
+        for images, _, _, labels, _ in loader:
+            logits = model(images.to(device)).cpu()
+            for i, label in enumerate(labels):
+                correct += _greedy_decode(logits[:, i])[0] == label
+                count += 1
+    return {"correct": correct, "n": count, "accuracy": correct/count}
+
+
+def run(args) -> dict:
+    torch.set_num_threads(args.threads)
+    cv2.setNumThreads(1)
+    random.seed(args.seed)
+    np.random.seed(args.seed)
+    torch.manual_seed(args.seed)
+    if args.workers != 0:
+        raise ValueError("resource-constrained release uses DataLoader workers=0")
+    ram_limit = 1_000_000_000 if args.smoke and args.device == "cpu" else 2_700_000_000
+    if args.epochs < 30 and not args.smoke:
+        raise ValueError("release training requires at least 30 complete epochs")
+    if not args.smoke:
+        if args.audit is None:
+            raise ValueError("release training requires --audit")
+        audit = json.loads(args.audit.read_text(encoding="utf-8-sig"))
+        hashes = audit["output_hashes"]
+        if file_sha256(args.tune) != hashes["tune.csv"] or file_sha256(args.sampler) != hashes["sampler.json"]:
+            raise ValueError("tune or sampler differs from the isolation audit")
+        if args.decode_jpeg:
+            if args.device != "cuda" or file_sha256(args.train) != hashes["pool.csv"]:
+                raise ValueError("CUDA JPEG training requires the audited original pool")
+        else:
+            cache_audit_path = args.train.parent / "audit.json"
+            cache_audit = json.loads(cache_audit_path.read_text(encoding="utf-8-sig"))
+            if (cache_audit.get("pool_sha256") != hashes["pool.csv"]
+                    or file_sha256(args.train) != cache_audit.get("cache_index_sha256")):
+                raise ValueError("cache training index differs from the audited full pool")
+        checks = audit["content_checks"]
+        if any(checks[key] != 0 for key in ("train_tune_sha_overlap", "train_protected_sha_overlap",
+                                           "tune_protected_sha_overlap")):
+            raise ValueError("training data overlaps held-out source bytes")
+    args.out.mkdir(parents=True, exist_ok=True)
+    if args.device == "cuda":
+        if free_ram_bytes() < 4_000_000_000:
+            raise RuntimeError("less than 4 GB free RAM; wait before GPU training")
+        torch.cuda.set_per_process_memory_fraction(.42)
+        # .42 is the dispatch ceiling; also honor a strict decimal 5 GB allocator cap.
+        strict_fraction = min(.42, 5_000_000_000/torch.cuda.get_device_properties(0).total_memory)
+        torch.cuda.set_per_process_memory_fraction(strict_fraction)
+        torch.backends.cudnn.benchmark = False
+    device = torch.device(args.device)
+    metadata = json.loads(args.sampler.read_text(encoding="utf-8"))
+    samples = metadata.get("samples_by_subset", metadata.get("subsets", metadata))
+    dataset = BoxDataset(args.train, samples, training=True, seed=args.seed,
+                         gpu_fallback=args.device == "cuda")
+    tune = BoxDataset(args.tune, samples, training=False, seed=args.seed)
+    if args.packed_cache:
+        from lpr_tools.train.packed_box_batches import PackedBoxBatches
+        loader = PackedBoxBatches(dataset, args.batch_size, collate)
+    elif args.decode_jpeg:
+        from lpr_tools.train.gpu_box_batches import GpuBoxBatches
+        loader = GpuBoxBatches(dataset, args.batch_size, collate, read_threads=3)
+    else:
+        loader = DataLoader(dataset, batch_size=args.batch_size, shuffle=True, num_workers=0,
+                            drop_last=False, collate_fn=collate,
+                            generator=torch.Generator().manual_seed(args.seed))
+    tune_loader = DataLoader(tune, batch_size=args.batch_size, shuffle=False,
+                             num_workers=0, collate_fn=collate)
+    model = BoxNet(imagenet=args.imagenet).to(device)
+    init_source = None
+    if args.init_checkpoint:
+        init_source = {"path": str(args.init_checkpoint.resolve()), "sha256": file_sha256(args.init_checkpoint)}
+        saved = torch.load(args.init_checkpoint, map_location="cpu", weights_only=True)
+        from lpr.recognize.box_reader import ARCH
+        if saved.get("architecture") != ARCH or saved.get("input_size") != list(INPUT_SIZE):
+            raise ValueError("initial checkpoint architecture mismatch")
+        model.load_state_dict(saved["state_dict"], strict=True)
+        init_source["optimizer_reset"] = True
+    optimizer = torch.optim.AdamW(model.parameters(), lr=args.lr, weight_decay=1e-4)
+    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, args.epochs, eta_min=1e-5)
+    loss_fn = nn.CTCLoss(blank=NUM_CLASSES, zero_infinity=False)
+    history = []
+    best = -1.
+    started = time.perf_counter()
+    ram_peak = 0
+    for epoch in range(args.epochs):
+        dataset.epoch = epoch
+        model.train()
+        loss_sum = 0.
+        seen = np.zeros(len(dataset), dtype=np.bool_)
+        epoch_started = time.perf_counter()
+        for step, (images, targets, lengths, _, indices) in enumerate(loader, 1):
+            if seen[indices].any():
+                raise RuntimeError("duplicate sample within an epoch")
+            seen[indices] = True
+            optimizer.zero_grad(set_to_none=True)
+            logits = model(images.to(device))
+            loss = loss_fn(logits.log_softmax(-1), targets.to(device),
+                           torch.full((len(images),), logits.shape[0], dtype=torch.long), lengths)
+            if not torch.isfinite(loss):
+                raise RuntimeError("non-finite training loss")
+            loss.backward()
+            nn.utils.clip_grad_norm_(model.parameters(), 5.)
+            optimizer.step()
+            loss_sum += float(loss.detach()) * len(images)
+            if step % 50 == 0 or step == 1:
+                ram = process_ram_bytes()
+                ram_peak = max(ram_peak, ram)
+                if ram > ram_limit:
+                    raise RuntimeError(f"own process RAM exceeds budget {ram_limit}: {ram}")
+                print(json.dumps({"epoch": epoch+1, "step": step, "seen": int(seen.sum()),
+                                  "loss": float(loss.detach()), "ram_bytes": ram,
+                                  "seconds": time.perf_counter()-started}), flush=True)
+        if not seen.all():
+            raise RuntimeError("incomplete epoch")
+        payload = checkpoint(model) if not args.smoke else None
+        if not args.smoke:
+            torch.save(payload, args.out / "last.pt")
+        if args.device == "cuda":
+            # All selection inference, like final evaluation, uses the office CPU venv.
+            scored = subprocess.run([str(args.cpu_python), "-m", "lpr_tools.train.score_box_reader",
+                                     "--model", str(args.out / "last.pt"), "--tune", str(args.tune)],
+                                    check=True, text=True, capture_output=True, encoding="utf-8")
+            score = json.loads(scored.stdout)
+        else:
+            score = evaluate(model, tune_loader, device)
+        record = {"epoch": epoch+1, "samples": len(dataset), "unique_samples": int(seen.sum()),
+                  "loss": loss_sum/len(dataset), "tune": score,
+                  "lr": optimizer.param_groups[0]["lr"],
+                  "seconds": time.perf_counter()-epoch_started}
+        history.append(record)
+        if score["accuracy"] > best:
+            best = score["accuracy"]
+            if not args.smoke:
+                torch.save(payload, args.out / "best.pt")
+        scheduler.step()
+        report = {"recipe": vars(args) | {"device": str(device)}, "history": history,
+                  "best_accuracy": best, "best_epoch": max(history, key=lambda r:r["tune"]["accuracy"])["epoch"],
+                  "total_exposures": len(dataset)*(epoch+1),
+                  "ram_peak_bytes": max(ram_peak, process_ram_bytes(peak=True)),
+                  "gpu_allocated_peak": torch.cuda.max_memory_allocated() if device.type == "cuda" else 0,
+                  "gpu_reserved_peak": torch.cuda.max_memory_reserved() if device.type == "cuda" else 0,
+                  "io_reduced_for_low_memory": getattr(loader, "reduced_for_memory", False),
+                  "original_gpu_fallbacks": getattr(loader, "original_fallbacks", 0),
+                  "init_source": init_source,
+                  "wall_seconds": time.perf_counter()-started,
+                  "train_sha256": file_sha256(args.train), "tune_sha256": file_sha256(args.tune)}
+        (args.out / "history.json").write_text(json.dumps(report, default=str, indent=2), encoding="utf-8")
+        projection = {"completed_epochs": epoch+1, "latest_epoch_seconds": record["seconds"],
+                      "mean_epoch_seconds": sum(r["seconds"] for r in history)/len(history),
+                      "projected_total_seconds": sum(r["seconds"] for r in history)/len(history)*args.epochs,
+                      "exceeds_eight_hours": sum(r["seconds"] for r in history)/len(history)*args.epochs > 28800}
+        (args.out / "projection.json").write_text(json.dumps(projection, indent=2), encoding="utf-8")
+        if epoch == 0:
+            with Path("algorithm/out/receipts/第十批.md").open("a", encoding="utf-8") as receipt:
+                receipt.write("\n首个正式epoch已完成："+json.dumps(projection, ensure_ascii=False)+"\n")
+            if projection["exceeds_eight_hours"]:
+                raise RuntimeError("first-epoch projection exceeds 8 hours; reduce scale before continuing")
+        print(json.dumps(record), flush=True)
+    return report
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--train", type=Path, required=True)
+    parser.add_argument("--tune", type=Path, required=True)
+    parser.add_argument("--sampler", type=Path, required=True)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--audit", type=Path)
+    parser.add_argument("--device", choices=("cpu", "cuda"), default="cpu")
+    parser.add_argument("--epochs", type=int, default=30)
+    parser.add_argument("--batch-size", type=int, default=64)
+    parser.add_argument("--workers", type=int, default=0)
+    parser.add_argument("--threads", type=int, choices=(1, 2, 3, 4), default=2)
+    parser.add_argument("--lr", type=float, default=.001)
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--imagenet", action="store_true")
+    parser.add_argument("--decode-jpeg", action="store_true", help="batch torchvision CUDA JPEG decode of original images")
+    parser.add_argument("--packed-cache", action="store_true")
+    parser.add_argument("--init-checkpoint", type=Path)
+    parser.add_argument("--cpu-python", type=Path, default=Path(".venv/Scripts/python.exe").resolve())
+    parser.add_argument("--smoke", action="store_true", help="explicit non-release tiny CPU smoke")
+    parser.add_argument("--prepare-cache", type=Path)
+    args = parser.parse_args()
+    if args.prepare_cache:
+        cv2.setNumThreads(1)
+        print(json.dumps(prepare_cache(args.train, args.prepare_cache), indent=2))
+    else:
+        print(json.dumps(run(args), default=str))
+
+
+if __name__ == "__main__":
+    main()
