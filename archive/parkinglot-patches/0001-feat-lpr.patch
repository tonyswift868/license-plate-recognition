+    if tune_fold_counts != {"fit": 1200, "report": 1200}:
+        raise ValueError(f"batch11 tune fold sizes changed: {tune_fold_counts}")
+    fold_overlap = len(tune_fold_shas["fit"] & tune_fold_shas["report"])
