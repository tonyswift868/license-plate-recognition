+    rel = encode_relative_target(absolute, ix, iy, gw, gh)
+    center = np.array([(ix + .5) / gw, (iy + .5) / gh], np.float32)
+    decoded = (rel.reshape(4, 2) + center - .5)
+    np.testing.assert_allclose(decoded, absolute, atol=1e-7)
