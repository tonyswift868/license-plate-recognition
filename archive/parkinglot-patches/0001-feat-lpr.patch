+
+def test_relative_green_guard_keeps_fit_default_eligible_when_absolute_rounding_would_not():
+    assert _green_gate_minimum(250, 231, "relative_default") == 231
+    assert _green_gate_minimum(250, 231, "strict_absolute") == 232
