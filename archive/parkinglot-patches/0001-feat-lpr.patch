+    """
+
+    name: str
+    version: str
+
+    def detect(self, image: np.ndarray, max_candidates: int) -> list[PlateCandidate]:
+        """原图 BGR uint8 → 按 score 降序的车牌候选（原图坐标，corners 为 LT,RT,RB,LB，source="net"）。
