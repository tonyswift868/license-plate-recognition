+    - 输入为空（0×32×32）时返回 0×65。
+    """
+
+    name: str
+    version: str
+
+    def predict_proba(self, chars: np.ndarray) -> np.ndarray:
+        """输入 N×32×32 uint8，输出 N×65 float32，每行和为 1，列顺序即 CHARSET 下标。"""
+        ...
