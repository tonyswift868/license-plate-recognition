diff --git a/algorithm/pyproject.toml b/algorithm/pyproject.toml
new file mode 100644
index 0000000..4e37e41
--- /dev/null
+++ b/algorithm/pyproject.toml
@@ -0,0 +1,36 @@
+[build-system]
+requires = ["setuptools>=68"]
+build-backend = "setuptools.build_meta"
+
+[project]
+name = "lpr"
+dynamic = ["version"]
+description = "停车场收费系统 M2 车牌识别模块（纯 Python 算法包）"
+requires-python = ">=3.11"
+dependencies = [
+    "numpy>=1.26",
+    "opencv-python>=4.9,<5",
+    "torch>=2.2",
+    "scikit-learn>=1.3",
+    "pydantic>=2.6",
+    "loguru>=0.7",
+]
+
+[project.optional-dependencies]
+tools = ["pillow>=10"]
+dev = ["pytest>=8", "pytest-cov>=5", "pytest-benchmark>=4"]
+
+[tool.setuptools.dynamic]
+version = { attr = "lpr._version.__version__" }
+
+[tool.setuptools.packages.find]
+where = ["."]
+include = ["lpr*", "lpr_tools*"]
+
+[tool.pytest.ini_options]
+testpaths = ["tests"]
+# 保证在任何 worktree 里跑测试，导入的都是当前检出的 lpr，而不是别处的可编辑安装
+pythonpath = ["."]
+markers = [
+    "golden: 金样例回归（需要 tests/data/golden/ 下的图片）",
+]
diff --git a/algorithm/reports/scoreboard.md b/algorithm/reports/scoreboard.md
new file mode 100644
index 0000000..9b3e2bd
--- /dev/null
+++ b/algorithm/reports/scoreboard.md
@@ -0,0 +1,36 @@
+# M2 积分板
+
+日常只填验证集结果；测试集结果只在报告阶段填写。指标退步超过 1 个百分点就回滚该次合并（开发文档 10.2）。
+
+## 冻结测试集正式 G2（2026-10-28，只跑一次，之后不再调参）
+
+配置：develop 2a64ea4 的默认（与 a0b0002 取值相同）：char_cnn_v2 + crnn_v4 + box_reader_v3 + plate_det_v1@384，三路 011 + T20_A。
+清单：testset_manifest_v1.csv（320 张）。证据：03 第十八批回执与 per-image.jsonl；架构师按清单真值独立重算一致。
+
+| 组 | 整牌正确 | 正确率 | 门槛 | 达标 | 自动正确/自动通过 |
+| --- | --- | --- | --- | --- | --- |
+| 清晰 | 148/150 | 98.67% | ≥95% | ✅ | 144/144 |
+| 夜间 | 48/50 | 96.00% | ≥85% | ✅ | 45/45 |
+| 倾斜 | 49/50 | 98.00% | ≥85% | ✅ | 47/48 |
+| 污损 | 48/50 | 96.00% | ≥85% | ✅ | 46/46 |
+| 四组合计 | 293/300 | 97.67% | — | — | 282/283 = 99.65% |
