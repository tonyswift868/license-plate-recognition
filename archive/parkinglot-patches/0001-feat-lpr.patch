index 0000000..0454034
--- /dev/null
+++ b/algorithm/lpr_tools/eval/locate_recall.py
@@ -0,0 +1,37 @@
+"""Top-3 localization recall, measured independently of recognition status."""
+from __future__ import annotations
+
+from lpr.config import LprConfig
+from lpr.locate import locate
+from lpr.preprocess import preprocess
+
+TOP_K = 3
+IOU_THRESHOLD = 0.5
+
+
+def box_iou(a, b) -> float:
+    left, top = max(a[0], b[0]), max(a[1], b[1])
+    right, bottom = min(a[0]+a[2], b[0]+b[2]), min(a[1]+a[3], b[1]+b[3])
+    intersection = max(0., right-left)*max(0., bottom-top)
+    union = a[2]*a[3]+b[2]*b[3]-intersection
+    return intersection/union if union > 0 else 0.
+
+
+def locate_match(image, truth_bbox, cfg: LprConfig) -> dict:
+    """Input and candidate boxes are original-image pixels; no scaling of GT."""
+    pre = preprocess(image, cfg.preprocess)
+    candidates = locate(pre, cfg.locate, max_candidates=TOP_K)[:TOP_K]
+    best = max((box_iou(candidate.bbox, truth_bbox) for candidate in candidates), default=0.)
+    return {"hit": best >= IOU_THRESHOLD, "best_iou": best, "candidates": len(candidates)}
+
+
+def summarize(matches: list[tuple[str, dict]], *, excluded_np: int = 0) -> dict:
+    def summary(values):
+        total, hits = len(values), sum(item["hit"] for item in values)
+        return {"hits": hits, "total": total, "recall": hits/total if total else None}
+    groups = sorted({key for key, _ in matches})
+    return {"topk": TOP_K, "iou_threshold": IOU_THRESHOLD,
+            "locator": "lpr.preprocess + lpr.locate (independent of classifier)",
+            "overall": summary([item for _, item in matches]),
+            "subsets": {key: summary([item for name, item in matches if name == key]) for key in groups},
+            "excluded_np": excluded_np}
diff --git a/algorithm/lpr_tools/eval/province_pipeline.py b/algorithm/lpr_tools/eval/province_pipeline.py
new file mode 100644
index 0000000..2a74de0
--- /dev/null
+++ b/algorithm/lpr_tools/eval/province_pipeline.py
@@ -0,0 +1,317 @@
+"""Run the full three-route pipeline on the fixed province holdout and synth panel."""
+from __future__ import annotations
+
+import argparse
+import csv
+import gzip
+import hashlib
+import json
+from collections import Counter, defaultdict
+from pathlib import Path
+
+HOLDOUT_N = 486
+SYNTHETIC_N = 930
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def _rows(path: Path, expected_fields: tuple[str, ...]) -> list[dict[str, str]]:
+    with Path(path).open("r", encoding="utf-8-sig", newline="") as stream:
+        reader = csv.DictReader(stream)
+        if tuple(reader.fieldnames or ()) != expected_fields:
+            raise ValueError(f"unexpected panel columns in {path}: {reader.fieldnames}")
+        rows = list(reader)
+    if any(None in row or any(value is None for value in row.values()) for row in rows):
+        raise ValueError(f"malformed CSV row in {path}")
+    return rows
+
+
+def _quad(value: str) -> list[list[float]]:
+    numbers = [float(item) for item in value.replace(",", " ").split()]
+    if len(numbers) != 8:
+        raise ValueError("panel quad must contain four ordered x,y pairs")
+    points = [[numbers[i], numbers[i + 1]] for i in range(0, 8, 2)]
+    if not all(abs(item) < 1e8 for point in points for item in point):
+        raise ValueError("panel quad contains invalid coordinates")
+    return points
+
+
+def _validate(rows: list[dict[str, str]], panel: str, provinces: tuple[str, ...],
+              expected_n: int) -> list[dict]:
+    if len(rows) != expected_n:
+        raise ValueError(f"{panel} panel must have {expected_n} rows; got {len(rows)}")
+    prepared = []
+    for index, row in enumerate(rows):
+        label = row["label"]
+        if not label or len(label) not in (7, 8) or label[0] not in provinces:
+            raise ValueError(f"invalid province label in {panel} row {index}")
+        item = {**row, "_row": index, "_truth": label, "_source_path": Path(row["path"]),
+                "_quad": _quad(row["quad"])}
+        if panel == "province_holdout":
+            if row["province"] != label[0]:
+                raise ValueError(f"province column disagrees with label in row {index}")
+        else:
+            if row["target_province"] not in provinces:
+                raise ValueError(f"invalid synthetic target province in row {index}")
+            if not row["seed"].isdigit():
+                raise ValueError(f"invalid synthesis seed in row {index}")
+            item["_truth"] = row["target_province"] + label[1:]
+        prepared.append(item)
+    if panel == "synth_eval":
+        counts = Counter(row["target_province"] for row in prepared)
+        expected = {province: 30 for province in provinces}
+        if counts != expected:
+            raise ValueError(f"synthetic panel must contain exactly 30 rows per province: {counts}")
+    return prepared
+
+
+def _metrics(rows: list[dict]) -> dict:
+    n = len(rows)
+    accepted = [row for row in rows if row["status"] == "OK"]
+    correct = sum(row["plate_prediction"] == row["truth"] for row in rows)
+    province_correct = sum(row["predicted_province"] == row["truth"][0] for row in rows)
+    accepted_correct = sum(row["plate_prediction"] == row["truth"] for row in accepted)
+    return {
+        "n": n,
+        "plate_correct": correct,
+        "plate_accuracy": correct / n if n else None,
+        "province_correct": province_correct,
+        "province_accuracy": province_correct / n if n else None,
+        "predicted_皖": sum(row["predicted_province"] == "皖" for row in rows),
+        "wrong_as_皖": sum(row["predicted_province"] == "皖" and row["truth"][0] != "皖" for row in rows),
+        "auto_accepted": len(accepted),
+        "auto_correct": accepted_correct,
+        "auto_precision": accepted_correct / len(accepted) if accepted else None,
+        "input_error": sum(bool(row["input_error"]) for row in rows),
+        "status_counts": dict(sorted(Counter(row["status"] for row in rows).items())),
+    }
+
+
+def summarize(records: list[dict]) -> dict:
+    groups: dict[str, list[dict]] = defaultdict(list)
+    for record in records:
+        groups["overall"].append(record)
+        groups[f"panel/{record['panel']}"].append(record)
+        groups[f"province/{record['truth'][0]}"].append(record)
+        groups[f"panel_province/{record['panel']}/{record['truth'][0]}"].append(record)
+        if record.get("subset"):
+            groups[f"subset/{record['subset']}"].append(record)
+            groups[f"panel_subset/{record['panel']}/{record['subset']}"].append(record)
+    return {name: _metrics(rows) for name, rows in sorted(groups.items())}
+
+
+def _model_identity(recognizer, config_path: Path) -> dict:
+    from lpr.config import ALGORITHM_DIR
+
+    cfg = recognizer.config
+    models = {}
+    for field in ("model_path", "plate_reader_model_path", "box_reader_model_path", "corner_model_path"):
+        value = getattr(cfg.runtime, field)
+        path = cfg.resolve_path(value) if value else None
+        models[field] = None if path is None else {
+            "path": str(path.resolve()), "sha256": _sha256(path),
+        }
+    manifest = ALGORITHM_DIR / "models" / "manifest.json"
+    return {
+        "version": recognizer.version,
+        "config_path": str(config_path.resolve()),
+        "config_sha256": _sha256(config_path),
+        "effective_config": json.loads(cfg.model_dump_json()),
+        "models": models,
+        "manifest_path": str(manifest.resolve()),
+        "manifest_sha256": _sha256(manifest),
+        "detector_input_size": cfg.runtime.detector_input_size,
+        "torch_threads": cfg.runtime.torch_threads,
+    }
+
+
+def _run_panel(recognizer, panel: str, rows: list[dict], records_stream,
+               source_hashes: dict[str, str], progress) -> list[dict]:
+    from lpr.errors import failure_result
+    from lpr.io_utils import imread
+    from lpr.types import RecogStatus
+
+    import numpy as np
+    from lpr_tools.train.province_synth import replace_province
+
+    records = []
+    for item in rows:
+        path = item["_source_path"].resolve()
+        key = str(path).casefold()
+        source_hash = source_hashes.get(key)
+        input_error = None
+        image = None
+        generated = None
+        synth_meta = None
+        frame_shape = None
+        synth_seed = None
+        try:
+            if source_hash is None:
+                input_error = "source file is missing"
+            else:
+                image = imread(path)
+                if panel == "synth_eval":
+                    synth_seed = int(item["seed"])
+                    image, generated, synth_meta = replace_province(
+                        image, item["_quad"], item["label"], item["target_province"],
+                        np.random.default_rng(synth_seed))
+                    if generated != item["_truth"]:
+                        raise ValueError("synthesizer output label differs from frozen target")
+                frame_shape = list(image.shape)
+                result = recognizer.recognize(image)
+        except (OSError, ValueError) as exc:
+            input_error = f"{type(exc).__name__}: {exc}"
+        if input_error:
+            result = failure_result(RecogStatus.BAD_INPUT)
+        prediction = result.plate_no
+        province_prediction = prediction[0] if prediction else None
+        truth = item["_truth"]
+        record = {
+            "panel": panel,
+            "row": item["_row"],
+            "path": str(path),
+            "source_sha256": source_hash,
+            "subset": item.get("subset"),
+            "split": item.get("split"),
+            "brightness": item.get("brightness"),
+            "source_label": item["label"],
+            "truth": truth,
+            "synth_target_province": item.get("target_province") if panel == "synth_eval" else None,
+            "synth_seed": synth_seed if synth_seed is not None else (item.get("seed") if panel == "synth_eval" else None),
+            "synth_metadata": synth_meta if panel == "synth_eval" and not input_error else None,
+            "panel_row_metadata": {key: value for key, value in item.items() if not key.startswith("_")},
+            "frame_shape": frame_shape,
+            "frame_resized": False,
+            "status": result.status.value,
+            "plate_prediction": prediction,
+            "predicted_province": province_prediction,
+            "plate_correct": prediction == truth,
+            "province_correct": province_prediction == truth[0],
+            "confidence": float(result.confidence),
+            "auto_accepted": result.status == RecogStatus.OK,
+            "input_error": input_error,
+            "elapsed_ms": float(result.elapsed_ms),
+        }
+        records.append(record)
+        records_stream.write(json.dumps(record, ensure_ascii=False, separators=(",", ":")) + "\n")
+        if len(records) % 50 == 0:
+            progress(panel, item["_row"] + 1, len(rows))
+        del result, image
+    return records
+
+
+def run(*, config_path: Path | None, holdout_path: Path, synthetic_path: Path,
+        out_dir: Path) -> dict:
+    import cv2
+    import torch
+    from loguru import logger
+    from lpr.config import DEFAULT_CONFIG_PATH
+    from lpr.pipeline import PlateRecognizer
+    from lpr.charset import PROVINCES
+    from lpr_tools.train.province_synth import DEFAULT_FONT
+
+    config_path = Path(config_path or DEFAULT_CONFIG_PATH).resolve()
+    holdout_path, synthetic_path, out_dir = (Path(path).resolve() for path in
+                                             (holdout_path, synthetic_path, out_dir))
+    if out_dir.exists() and any(out_dir.iterdir()):
+        raise FileExistsError(f"refusing to overwrite nonempty output directory: {out_dir}")
+    holdout = _validate(_rows(holdout_path, ("path", "province", "label", "subset", "brightness", "quad", "sha256", "split")),
+                        "province_holdout", tuple(PROVINCES), HOLDOUT_N)
+    synthetic = _validate(_rows(synthetic_path, ("path", "label", "subset", "brightness", "quad", "sha256", "target_province", "seed")),
+                          "synth_eval", tuple(PROVINCES), SYNTHETIC_N)
+    source_rows = [*holdout, *synthetic]
+    row_seeds = [int(item["seed"]) for item in synthetic]
+    seed_counts = Counter(row_seeds)
+    source_hashes = {}
+    source_errors = {}
+    for item in source_rows:
+        path = item["_source_path"].resolve()
+        key = str(path).casefold()
+        if key not in source_hashes and key not in source_errors:
+            if not path.is_file():
+                source_errors[key] = "source file is missing"
+            else:
+                actual_hash = _sha256(path)
+                if actual_hash != item["sha256"].lower():
+                    raise ValueError(f"source file sha256 differs from panel: {path}")
+                source_hashes[key] = actual_hash
+    for item in source_rows:
+        if str(item["_source_path"].resolve()).casefold() not in source_hashes:
+            continue
+        if item["sha256"].lower() != source_hashes[str(item["_source_path"].resolve()).casefold()]:
+            raise ValueError(f"same source path has inconsistent SHA in panel rows: {item['_source_path']}")
+
+    torch.set_num_threads(2)
+    cv2.setNumThreads(1)
+    logger.remove()
+    recognizer = (PlateRecognizer.from_config() if config_path == DEFAULT_CONFIG_PATH.resolve()
+                  else PlateRecognizer.from_config(str(config_path)))
+    if recognizer.config.runtime.torch_threads > 4:
+        raise ValueError("province pipeline evaluation is limited to four Torch threads")
+    identity = _model_identity(recognizer, config_path)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    meta = {
+        "schema": "batch17-province-pipeline-v1",
+        "model_identity": identity,
+        "holdout": {"path": str(holdout_path), "sha256": _sha256(holdout_path), "rows": len(holdout)},
+        "synthetic": {"path": str(synthetic_path), "sha256": _sha256(synthetic_path), "rows": len(synthetic),
+                      "seed_policy": "numpy.random.default_rng(int(row.seed)); row seed is authoritative",
+                      "seed_n": len(row_seeds), "seed_unique": len(seed_counts),
+                      "seed_min": min(seed_counts), "seed_max": max(seed_counts),
+                      "font_path": str(DEFAULT_FONT.resolve()), "font_sha256": _sha256(DEFAULT_FONT)},
+        "input_errors_preflight": source_errors,
+        "input_method": {
+            "holdout": "existing full-resolution source frame; no crop/resize; pipeline detects and locates on its ordinary inputs",
+            "synthetic": "existing replace_province on the full-resolution original frame with source-image quad and row RNG; generated frame is passed unchanged to the pipeline",
+            "synthetic_crop_difference": "batch12 single-reader panel synthesizes on the full source frame, then uses GT box/quad crops for each isolated reader; this evaluation uses the same synthesized source-frame pixels but the full pipeline detector/locate/candidate crops",
+            "image_decode": "lpr.io_utils.imread, same byte-array cv2.imdecode path as batch12 panel reader",
+        },
+        "records": str((out_dir / "records.jsonl.gz").resolve()),
+    }
+    (out_dir / "meta.json").write_text(json.dumps(meta, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    all_records = []
+    with gzip.open(out_dir / "records.jsonl.gz", "wt", encoding="utf-8", newline="\n") as stream:
+        def progress(panel, done, total):
+            print(f"{panel} {done}/{total}", flush=True)
+        for panel, rows in (("province_holdout", holdout), ("synth_eval", synthetic)):
+            all_records.extend(_run_panel(recognizer, panel, rows, stream, source_hashes, progress))
+    if len(all_records) != HOLDOUT_N + SYNTHETIC_N:
+        raise AssertionError("fixed province panel denominator changed")
+    report = {
+        "schema": "batch17-province-pipeline-report-v1",
+        "model_identity": identity,
+        "counts": {"province_holdout": HOLDOUT_N, "synth_eval": SYNTHETIC_N,
+                   "total": len(all_records)},
+        "metrics": summarize(all_records),
+        "inputs": {"holdout_sha256": meta["holdout"]["sha256"],
+                   "synth_sha256": meta["synthetic"]["sha256"]},
+        "pixel_method": meta["input_method"],
+        "input_errors": {"total": sum(bool(r["input_error"]) for r in all_records),
+                          "by_panel": {p: sum(bool(r["input_error"]) for r in all_records if r["panel"] == p)
+                                       for p in ("province_holdout", "synth_eval")}},
+    }
+    (out_dir / "report.json").write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    return report
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", type=Path, help="model/config file; omitted uses the default config")
+    parser.add_argument("--holdout", type=Path, required=True)
+    parser.add_argument("--synthetic", type=Path, required=True)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args(argv)
+    report = run(config_path=args.config, holdout_path=args.holdout,
+                 synthetic_path=args.synthetic, out_dir=args.out)
+    print(json.dumps({"counts": report["counts"], "out": str(args.out.resolve())}, ensure_ascii=False))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/algorithm/lpr_tools/eval/route_features.py b/algorithm/lpr_tools/eval/route_features.py
new file mode 100644
index 0000000..7a986a0
--- /dev/null
+++ b/algorithm/lpr_tools/eval/route_features.py
@@ -0,0 +1,282 @@
+"""Stream prediction-only geometry and pixel features for a three-route trace.
+
+This tool reruns only the configured locator (CornerNet + classical proposals),
+never the segment, rectified-reader, or box-reader recognition routes. It does
+not read labels or ground-truth quadrilaterals.
+"""
+from __future__ import annotations
+
+import argparse
+import gzip
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+
+for _name in ("OMP_NUM_THREADS", "MKL_NUM_THREADS", "OPENBLAS_NUM_THREADS",
+              "BLIS_NUM_THREADS", "NUMEXPR_NUM_THREADS"):
+    os.environ[_name] = "1"
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def _trace_rows(path: Path):
+    opener = gzip.open if Path(path).suffix.lower() == ".gz" else open
+    metadata = None
+    with opener(path, "rt", encoding="utf-8") as stream:
+        for line_no, line in enumerate(stream, 1):
+            if not line.strip():
+                continue
+            row = json.loads(line)
+            if line_no == 1 and isinstance(row, dict) and "_meta" in row:
+                metadata = row["_meta"]
+                continue
+            if not isinstance(row, dict) or not isinstance(row.get("path"), str):
+                raise ValueError(f"trace row {line_no} has no path")
+            yield row
+    if metadata is None:
+        raise ValueError("trace is missing its first-line _meta identity")
+
+
+def _read_trace_metadata(path: Path) -> dict:
+    opener = gzip.open if Path(path).suffix.lower() == ".gz" else open
+    with opener(path, "rt", encoding="utf-8") as stream:
+        first = stream.readline()
+    try:
+        row = json.loads(first)
+    except (json.JSONDecodeError, TypeError) as exc:
+        raise ValueError("trace first line is not valid metadata JSON") from exc
+    metadata = row.get("_meta") if isinstance(row, dict) else None
+    if not isinstance(metadata, dict):
+        raise ValueError("trace is missing first-line _meta identity")
+    return metadata
+
+
+def _validate_identity(trace_meta: dict, detector_identity: dict,
+                       effective_config: dict) -> None:
+    """Ensure the replay uses the exact detector and locator configuration."""
+    if trace_meta.get("schema") != "three-route-live-v1":
+        raise ValueError("trace metadata schema must be three-route-live-v1")
+    expected_detector = trace_meta.get("models", {}).get("detector", {}).get("sha256")
+    if not expected_detector or detector_identity.get("sha256") != expected_detector:
+        raise ValueError("detector model SHA differs from source trace")
+    expected_config = trace_meta.get("config", {}).get("effective_config")
+    actual_config = effective_config.get("effective_config")
+    if not isinstance(expected_config, dict) or not isinstance(actual_config, dict):
+        raise ValueError("trace or replay is missing effective configuration")
+    for key in ("preprocess", "locate", "lanes"):
+        if actual_config.get(key) != expected_config.get(key):
+            raise ValueError(f"locator config differs from trace in {key}")
+    if (actual_config.get("runtime", {}).get("max_candidates") !=
+            expected_config.get("runtime", {}).get("max_candidates")):
+        raise ValueError("locator config differs from trace in runtime.max_candidates")
+
+
+def _candidate_agrees(candidate, traced: dict, index: int) -> None:
+    """Fail closed if the locator replay changes candidate identity or order."""
+    expected = traced.get(str(index))
+    if expected is None:
+        raise ValueError(f"trace missing candidate index {index}")
+    if int(expected.get("candidate_index", -1)) != index:
+        raise ValueError(f"trace candidate index mismatch at {index}")
+    if expected.get("source") != candidate.source:
+        raise ValueError(f"candidate source mismatch at index {index}")
+    box = [int(value) for value in candidate.bbox]
+    if expected.get("bbox") != box:
+        raise ValueError(f"candidate bbox mismatch at index {index}")
+    if not math.isclose(float(expected.get("score")), float(candidate.score),
+                        rel_tol=0.0, abs_tol=1e-7):
+        raise ValueError(f"candidate score mismatch at index {index}")
+
+
+def _tilt_angle_deg(corners) -> float:
+    """Mean absolute top/bottom horizontal-edge angle, in degrees.
+
+    Corners must be ordered LT, RT, RB, LB in original-image coordinates.
+    """
+    points = [(float(x), float(y)) for x, y in corners]
+    if len(points) != 4 or not all(math.isfinite(v) for p in points for v in p):
+        raise ValueError("candidate requires four finite ordered corners")
+    top = math.degrees(math.atan2(points[1][1] - points[0][1],
+                                 points[1][0] - points[0][0]))
+    bottom = math.degrees(math.atan2(points[2][1] - points[3][1],
+                                    points[2][0] - points[3][0]))
+    return (abs(top) + abs(bottom)) / 2.0
+
+
+def _layout_lengths(row: dict, candidate_index: int) -> list[int]:
+    lengths = set()
+    for rect in row.get("rects", []):
+        if rect.get("candidate_index") != candidate_index:
+            continue
+        for route in ("segment", "reader"):
+            attempt = rect.get(route)
+            if attempt and attempt.get("valid") and isinstance(attempt.get("plate"), str):
+                length = len(attempt["plate"])
+                if length in (7, 8):
+                    lengths.add(length)
+    return sorted(lengths)
+
+
+def _box_gray_mean(gray, bbox):
+    x, y, width, height = (int(v) for v in bbox)
+    h, w = gray.shape[:2]
+    x0, y0 = max(0, x), max(0, y)
+    x1, y1 = min(w, x + width), min(h, y + height)
+    crop = gray[y0:y1, x0:x1]
+    return float(crop.mean()) if crop.size else None
+
+
+def enrich_trace(*, trace_path, config_path, output_path, detector_model=None,
+                 detector_loader=None):
+    """Write gzip JSONL prediction-only features; refuses every output overwrite."""
+    import cv2
+    import numpy as np
+    import torch
+    from lpr.config import load_config
+    from lpr.recognize import load_corner_detector
+    from lpr_tools.eval.box_direct import _actual_candidates
+
+    source = Path(trace_path).resolve()
+    target = Path(output_path).resolve()
+    config_file = Path(config_path).resolve()
+    if target.exists():
+        raise FileExistsError(f"refusing to overwrite feature trace: {target}")
+    trace_meta = _read_trace_metadata(source)
+    torch.set_num_threads(2)
+    cv2.setNumThreads(1)
+    cfg = load_config(config_file, runtime__torch_threads=2)
+    model_path = (Path(detector_model).resolve() if detector_model else
+                  cfg.resolve_path(cfg.runtime.corner_model_path)
+                  if cfg.runtime.corner_model_path else None)
+    if model_path is None:
+        raise ValueError("a configured or explicit CornerNet detector model is required")
+    from lpr_tools.eval.three_route import _model_manifest_identity
+    detector_identity = _model_manifest_identity(model_path)
+    from lpr_tools.eval.common import effective_config_info
+
+    effective_info = effective_config_info(cfg, config_file)
+    _validate_identity(trace_meta, detector_identity, effective_info)
+    if detector_loader:
+        from lpr_tools.eval.three_route import _load_custom_factory
+        detector = _load_custom_factory(detector_loader, model_path, "detect")
+    else:
+        detector = load_corner_detector(model_path)
+    effective_payload = effective_info.get("effective_config", effective_info)
+    effective_sha = hashlib.sha256(json.dumps(
+        effective_payload, ensure_ascii=False, sort_keys=True,
+        separators=(",", ":")).encode("utf-8")).hexdigest()
+    meta = {
+        "schema": "three-route-prediction-features-v1",
+        "source_trace": str(source), "source_trace_sha256": sha256_file(source),
+        "source_code_sha256": sha256_file(Path(__file__).resolve()),
+        "detector": {**detector_identity,
+                     "loader": detector_loader or "lpr.recognize.load_corner_detector"},
+        "config": {"path": str(config_file), "sha256": sha256_file(config_file),
+                   "effective_config_sha256": effective_sha, "effective": effective_info},
+        "runtime_threads": {"torch": 2, "opencv": 1, "blas": 1},
+        "candidate_replay": "box_direct._actual_candidates: configured corner detector + classical locator, merged top 3",
+        "feature_definitions": {
+            "tilt_angle_deg": "mean(abs(top-edge atan2 angle), abs(bottom-edge atan2 angle)); corners LT,RT,RB,LB",
+            "layout_lengths": "sorted unique lengths 7/8 from valid segment/reader attempts in the same candidate's trace rects",
+            "brightness_filename": "existing trace brightness field only; CCPD filename annotation, not pixel measurement",
+            "image_gray_mean": "mean of OpenCV BGR-to-gray image pixels, scale 0..255",
+            "box_gray_mean": "mean gray over candidate bbox clipped to image; no padding or rectification",
+            "color": "candidate locator's predicted color",
+        },
+        "scope": "prediction/pixel features only; no truth, GT quad, model recognition, or image output",
+    }
+    target.parent.mkdir(parents=True, exist_ok=True)
+    opener = gzip.open if target.suffix.lower() == ".gz" else open
+    count = 0
+    seen_paths = set()
+    try:
+        with opener(target, "wt", encoding="utf-8", newline="\n") as out:
+            out.write(json.dumps({"_meta": meta}, ensure_ascii=False,
+                                 separators=(",", ":")) + "\n")
+            for row in _trace_rows(source):
+                image_path = Path(row["path"])
+                image_bytes = image_path.read_bytes()
+                image_sha = hashlib.sha256(image_bytes).hexdigest()
+                image = cv2.imdecode(np.frombuffer(image_bytes, dtype=np.uint8),
+                                     cv2.IMREAD_COLOR)
+                del image_bytes
+                if image is None:
+                    raise ValueError(f"cannot decode trace image: {image_path}")
+                path_key = str(image_path.resolve()).casefold()
+                if path_key in seen_paths:
+                    raise ValueError(f"duplicate image path in trace: {image_path}")
+                seen_paths.add(path_key)
+                gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
+                image_gray_mean = float(gray.mean())
+                candidates = _actual_candidates(image, cfg, detector)
+                traced_boxes = row.get("boxes", {})
+                if int(row.get("candidate_count", -1)) != len(candidates):
+                    raise ValueError(f"candidate count changed for {image_path}")
+                if set(traced_boxes) != {str(i) for i in range(len(candidates))}:
+                    raise ValueError(f"trace candidate keys differ for {image_path}")
+                features = []
+                for ci, candidate in enumerate(candidates):
+                    _candidate_agrees(candidate, traced_boxes, ci)
+                    box_gray_mean = _box_gray_mean(gray, candidate.bbox)
+                    features.append({
+                        "candidate_index": ci,
+                        "source": candidate.source,
+                        "score": float(candidate.score),
+                        "bbox": [int(v) for v in candidate.bbox],
+                        "corners": [[float(x), float(y)] for x, y in candidate.corners],
+                        "tilt_angle_deg": _tilt_angle_deg(candidate.corners),
+                        "color": str(candidate.color),
+                        "layout_lengths": _layout_lengths(row, ci),
+                        "box_gray_mean": box_gray_mean,
+                    })
+                out.write(json.dumps({
+                    "path": row["path"], "candidate_count": len(candidates),
+                    "image_sha256": image_sha,
+                    "brightness_filename": row.get("brightness"),
+                    "image_gray_mean": image_gray_mean, "candidates": features,
+                }, ensure_ascii=False, separators=(",", ":")) + "\n")
+                count += 1
+                if count % 100 == 0:
+                    out.flush()
+                    print(f"route_features={count}/3100", flush=True)
+    except Exception:
+        # A failed partial trace must not look like a completed artifact.
+        try:
+            target.unlink()
+        except FileNotFoundError:
+            pass
+        raise
+    if count != 3100:
+        target.unlink(missing_ok=True)
+        raise ValueError(f"source trace must contain exactly 3100 records; got {count}")
+    if target.stat().st_size > 500_000_000:
+        target.unlink(missing_ok=True)
+        raise ValueError("compressed feature trace exceeds 500 MiB output budget")
+    return {"status": "complete", "records": count, "output": str(target),
+            "source_trace_sha256": meta["source_trace_sha256"]}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--trace", required=True, help="three-route JSONL or JSONL.gz")
+    parser.add_argument("--config", required=True)
+    parser.add_argument("--detector-model")
+    parser.add_argument("--detector-loader", help="optional module:factory implementing detect(image,max_candidates)")
+    parser.add_argument("--out", required=True, help="new .jsonl.gz output (must not exist)")
+    args = parser.parse_args(argv)
+    result = enrich_trace(trace_path=args.trace, config_path=args.config,
+                          detector_model=args.detector_model,
+                          detector_loader=args.detector_loader, output_path=args.out)
+    print(json.dumps(result, ensure_ascii=False), flush=True)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
