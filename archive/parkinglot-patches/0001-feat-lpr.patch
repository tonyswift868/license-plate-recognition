+    path.write_bytes(content)
+    return {"path": str(path), "split": "val", "subset": "ccpd_green", "has_plate": "1",
+            "skip_reason": "", "plate_no": label,
+            "quad": "0 0 20 0 20 8 0 8", "brightness": "16"}
