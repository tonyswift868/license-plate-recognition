+                         "brightness": "10", "sha256": "a" * 64,
+                         "quad": "2 2 8 2 8 6 2 6", "source": "test"})
+    monkeypatch.setattr(cache, "_read_image", lambda _path: np.full((10, 12, 3), 127, dtype=np.uint8))
+    target = tmp_path / "cache"
