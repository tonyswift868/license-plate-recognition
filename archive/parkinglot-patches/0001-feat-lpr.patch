+IMAGE_SIZE = (720, 1160)  # width, height: portrait CCPD frame
+SUBSETS_2019 = ("ccpd_base", "ccpd_db", "ccpd_tilt", "ccpd_blur", "ccpd_np")
+SPLITS_2020 = ("train", "val", "test")
