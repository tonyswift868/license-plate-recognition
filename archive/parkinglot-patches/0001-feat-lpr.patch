+++ b/algorithm/lpr_tools/eval/route_split.py
@@ -0,0 +1,104 @@
+"""Fixed seed, label-independent half split shared by three-route diagnostics."""
+from collections import defaultdict
+import hashlib
+import json
+from pathlib import Path
+import posixpath
+import random
+
+
+def path_key(path):
+    return posixpath.normpath(str(path).replace("\\", "/")).casefold()
+
+
+def split_assignments(records, seed=42, image_sha_by_path=None):
+    """Sort strata and paths, shuffle with one seeded RNG, use the first half.
+
+    Fixed membership/subset define strata. Optional source-byte SHA keeps exact
+    copies together, rebalancing with singleton rows in the seeded order.
+    Truth, predictions, confidence and pixel measurements are never used.
+    Odd strata put the extra item in hold. Duplicate normalized paths fail.
+    """
+    strata = defaultdict(list)
+    seen = set()
+    for row in records:
+        key = path_key(row["path"])
+        if key in seen:
+            raise ValueError(f"duplicate split path: {row['path']}")
+        if row["split"] not in {"val", "devhard"}:
+            raise ValueError("split requires fixed val/devhard membership")
+        seen.add(key)
+        strata[(row["split"], row["subset"])].append(key)
+    rng = random.Random(seed)
+    assignments = {}
+    orders = {}
+    for stratum in sorted(strata):
+        keys = sorted(strata[stratum])
+        rng.shuffle(keys)
+        orders[stratum] = keys
+        boundary = len(keys) // 2
+        assignments.update((key, "fit" if index < boundary else "hold")
+                           for index, key in enumerate(keys))
+    if image_sha_by_path is not None:
+        hashes = {path_key(path): sha for path, sha in image_sha_by_path.items()}
+        if set(hashes) != seen or any(not sha for sha in hashes.values()):
+            raise ValueError("content split requires every image SHA exactly once")
+        groups = defaultdict(list)
+        for key, sha in hashes.items():
+            groups[sha].append(key)
+        repeated = set()
+        for keys in groups.values():
+            if len(keys) > 1:
+                # Preserve the initial seeded assignment of the canonical path.
+                half = assignments[min(keys)]
+                repeated.update(keys)
+                assignments.update((key, half) for key in keys)
+        for stratum in sorted(orders):
+            keys = orders[stratum]
+            difference = len(keys) // 2 - sum(assignments[key] == "fit" for key in keys)
+            if difference == 0:
+                continue
+            source_half, target_half = ("hold", "fit") if difference > 0 else ("fit", "hold")
+            ordered = keys if difference > 0 else reversed(keys)
+            available = [key for key in ordered if key not in repeated
+                         and assignments[key] == source_half]
+            if len(available) < abs(difference):
+                raise ValueError("cannot balance exact stratum halves without splitting duplicate bytes")
+            for key in available[:abs(difference)]:
+                assignments[key] = target_half
+        assert_content_separation(assignments, hashes)
+    return assignments
+
+
+def assert_content_separation(assignments, image_sha_by_path):
+    """Reject same-byte images appearing in opposite halves."""
+    halves = defaultdict(set)
+    for path, sha in image_sha_by_path.items():
+        if not sha:
+            raise ValueError("image SHA is required for content separation")
+        halves[sha].add(assignments[path_key(path)])
+    if any(len(values) > 1 for values in halves.values()):
+        raise ValueError("same image bytes cross fit/hold; half split is not independent")
+
+
+def write_split(records, image_sha_by_path, trace_sha256, target, seed=42):
+    """Persist the content-safe assignment once for both evaluation tools."""
+    target = Path(target).resolve()
+    if target.exists():
+        raise FileExistsError(target)
+    records = list(records)
+    assignments = split_assignments(records, seed, image_sha_by_path)
+    counts = defaultdict(int)
+    for record in records:
+        counts[f"{record['split']}_{assignments[path_key(record['path'])]}"] += 1
+    amendment = Path(__file__).with_name("fallback_split_v1.json")
+    canonical = json.dumps(assignments, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+    payload = {"schema": "fallback-refine-split-v1", "seed": seed,
+        "strategy": "seeded stratum path split; exact-byte groups; singleton rebalance",
+        "trace_sha256": trace_sha256, "assignments": assignments,
+        "assignment_sha256": hashlib.sha256(canonical.encode("utf-8")).hexdigest(),
+        "counts": dict(counts), "split_amendment": str(amendment.resolve()),
+        "split_amendment_sha256": hashlib.sha256(amendment.read_bytes()).hexdigest()}
+    target.parent.mkdir(parents=True, exist_ok=True)
+    target.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
+    return payload
diff --git a/algorithm/lpr_tools/eval/runtime_acceptance.py b/algorithm/lpr_tools/eval/runtime_acceptance.py
new file mode 100644
index 0000000..d825671
--- /dev/null
+++ b/algorithm/lpr_tools/eval/runtime_acceptance.py
@@ -0,0 +1,85 @@
+"""Ordered real-pipeline comparison against immutable JSONL expectations."""
+from __future__ import annotations
+import argparse
+import gzip
+import hashlib
+import json
+import math
+from collections import Counter
+from pathlib import Path
+
+
+def _rows(path):
+    with gzip.open(path, "rt", encoding="utf-8") as stream:
+        return [r for line in stream if "_meta" not in (r := json.loads(line))]
+
+
+def compare(actual, expected, tolerance=1e-7):
+    differences = {key: {"expected": expected[key], "actual": actual.get(key)}
+                   for key in ("status", "plate", "route", "candidate_index", "rect_index")
+                   if key in expected and expected[key] != actual.get(key)}
+    ac, ec = float(actual["confidence"]), float(expected["confidence"])
+    if not (math.isfinite(ac) and math.isfinite(ec)) or abs(ac - ec) > tolerance:
+        differences["confidence"] = {"expected": expected["confidence"], "actual": actual["confidence"]}
+    return differences
+
+
+def run(config, manifests, expected_path, output, *, tolerance=1e-7):
+    import cv2
+    from loguru import logger
+    from lpr.pipeline import PlateRecognizer
+    from lpr.io_utils import imread
+    from lpr_tools.data.manifest import read_manifest, image_path
+    from .common import effective_config_info
+    logger.remove(); cv2.setNumThreads(1)
+    output = Path(output).resolve()
+    if output.exists() and any(output.iterdir()):
+        raise FileExistsError(f"refusing nonempty acceptance directory: {output}")
+    expected = _rows(expected_path)
+    samples = [(image_path(row, manifest), row) for manifest in manifests for row in read_manifest(manifest)]
+    norm = lambda p: str(p).replace("\\", "/").casefold()
+    if [norm(p) for p, _ in samples] != [norm(r["path"]) for r in expected]:
+        raise ValueError("manifest order/paths differ from frozen expectations")
+    recognizer = PlateRecognizer.from_config() if config is None else PlateRecognizer.from_config(config)
+    output.mkdir(parents=True, exist_ok=True)
+    mismatches, statuses = [], Counter()
+    with gzip.open(output/"actual.jsonl.gz", "wt", encoding="utf-8") as stream:
+        for i, ((path, _), frozen) in enumerate(zip(samples, expected), 1):
+            result = recognizer.recognize(imread(path))
+            actual = {"path": str(path), "status": result.status.value, "plate": result.plate_no,
+                "confidence": float(result.confidence), "route": getattr(result,"route",None),
+                "candidate_index":getattr(result,"candidate_index",None),
+                "rect_index":getattr(result,"rect_index",None)}
+            diff = compare(actual, frozen, tolerance)
+            if diff:
+                mismatches.append({"path":str(path),"differences":diff})
+            statuses[result.status.value] += 1
+            stream.write(json.dumps(actual,ensure_ascii=False,separators=(",", ":"))+"\n")
+            del result
+            if i % 100 == 0: print(f"runtime_acceptance={i}/{len(samples)}", flush=True)
+    report = {"rows":len(samples),"difference_count":len(mismatches),"differences":mismatches,
+        "statuses":dict(statuses),"model_version":recognizer.version,
+        "expected_sha256":hashlib.sha256(Path(expected_path).read_bytes()).hexdigest(),
+        "config":effective_config_info(recognizer.config,config),
+        "confidence_tolerance":tolerance,"no_threshold_comparison_tolerance":True}
+    (output/"report.json").write_text(json.dumps(report,ensure_ascii=False,indent=2),encoding="utf-8")
+    return report
+
+
+def main(argv=None):
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config",required=True)
+    parser.add_argument("--manifest",action="append",required=True)
+    parser.add_argument("--expected",required=True)
+    parser.add_argument("--out",required=True)
+    parser.add_argument("--confidence-tolerance", type=float, default=1e-7)
+    args=parser.parse_args(argv)
+    if not math.isfinite(args.confidence_tolerance) or args.confidence_tolerance < 0:
+        parser.error("confidence tolerance must be finite and nonnegative")
+    result=run(args.config,args.manifest,args.expected,args.out,tolerance=args.confidence_tolerance)
+    print(json.dumps({"rows":result["rows"],"difference_count":result["difference_count"]}))
+    return int(result["difference_count"]>0)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
