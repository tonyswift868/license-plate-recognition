+from __future__ import annotations
+
+import pytest
+
+from lpr_tools.eval.e1_threshold import (candidate_thresholds, recommend, scan, validate_provenance,
+                                        _stable_threshold)
+
+
+def attempt(index, plate, confidence, valid=True):
+    return {"attempt_index": index, "decoded": True, "plate_no": plate,
+            "confidence": confidence, "format_valid": valid, "color": "blue"}
+
+
+def test_threshold_candidates_include_every_boundary_and_just_above():
+    values = candidate_thresholds([{"attempts": [attempt(0, "PLATE001", .8)]}])
+    assert 0.0 in values and 1.0 in values and .8 in values
+    assert __import__("math").nextafter(.8, __import__("math").inf) in values
+
+
+def test_scan_replays_early_exit_for_each_threshold():
+    records = [
+        {"truth": "PLATE001", "lead_color": "blue", "candidate_count": 2,
+         "attempts": [attempt(0, "PLATE002", .90), attempt(1, "PLATE001", .85)]},
+        {"truth": "PLATE003", "lead_color": "blue", "candidate_count": 1,
+         "attempts": [attempt(0, "PLATE003", .70)]},
+    ]
+    rows, recommendation = scan(records)
+    at_80 = next(row for row in rows if row["threshold"] == .8)
+    assert at_80["accepted"] == 1
+    assert at_80["correct_accepted"] == 0
+    assert recommendation is None
+
+
+def test_stable_interior_threshold_preserves_maximum_coverage_plateau():
+    records = [
+        {"truth": "PLATE001", "lead_color": "blue", "candidate_count": 2,
+         "attempts": [attempt(0, "PLATE002", .8), attempt(1, "PLATE001", .9)]},
+        {"truth": "PLATE003", "lead_color": "blue", "candidate_count": 1,
+         "attempts": [attempt(0, "PLATE003", .7)]},
+    ]
+    rows, recommendation = scan(records)
+    assert recommendation is not None
+    stable = _stable_threshold(records, recommendation)
+    assert stable is not None
+    assert stable["accepted"] == recommendation["accepted"]
+    assert stable["correct_accepted"] == recommendation["correct_accepted"]
+    assert recommendation["threshold"] < stable["threshold"] < stable["next_coverage_boundary"]
+
+
+def test_recommendation_supports_a_stricter_conservative_precision_floor():
+    rows = [
+        {"threshold": .6, "accepted": 100, "correct_accepted": 99,
+         "auto_pass_precision": .99},
+        {"threshold": .8, "accepted": 80, "correct_accepted": 80,
+         "auto_pass_precision": 1.0},
+    ]
+    assert recommend(rows, .99)["accepted"] == 100
+    assert recommend(rows, .995)["accepted"] == 80
+
+
+def test_no_valid_attempts_reports_zero_coverage_without_precision():
+    record = {"truth": "PLATE001", "lead_color": "blue", "candidate_count": 1,
+              "attempts": [attempt(0, "bad", .99, valid=False)]}
+    rows, recommendation = scan([record])
+    assert all(row["accepted"] == 0 and row["auto_pass_precision"] is None for row in rows)
+    assert recommendation is None
+
+
+def test_empty_or_missing_truth_is_rejected():
+    with pytest.raises(ValueError):
+        scan([])
+    with pytest.raises(ValueError):
+        scan([{"truth": "", "attempts": []}])
+
+
+def test_provenance_rejects_non_validation_source_before_scanning(tmp_path):
+    with pytest.raises(ValueError, match="fixed val1000"):
+        validate_provenance([], tmp_path / "attempts.jsonl", {"selection": {"split": "test"}})
diff --git a/algorithm/tests/test_eval_fallback_selection.py b/algorithm/tests/test_eval_fallback_selection.py
new file mode 100644
index 0000000..d81f3a1
--- /dev/null
+++ b/algorithm/tests/test_eval_fallback_selection.py
@@ -0,0 +1,99 @@
+import pytest
+
+from lpr_tools.eval.fallback_selection import (apply_rule, compare_record, score, select_reader,
+                                               validate_params, _identity_verified)
+
+
+PARAMS = {"agree_min": 0.9, "solo_seg": 0.9, "solo_reader": 0.9, "prefer": "segment"}
+
+
+def attempt(text, conf, valid=True, status="OK"):
+    return {"plate": text, "confidence": conf, "valid": valid, "status": status}
+
+
+def rect(candidate, seg=None, reader=None):
+    return {"candidate_index": candidate, "segment": seg, "reader": reader}
+
+
+def test_ok_is_entirely_preserved():
+    record = {"rects": [rect(0, reader=attempt("R1", .99))]}
+    baseline = {"plate": "B", "confidence": .81, "status": "OK", "extra": "keep"}
+    assert apply_rule(record, baseline, "max_reader") == {
+        "plate": "B", "confidence": .81, "status": "OK", "extra": "keep",
+        "selection_source": "baseline_preserved", "changed": False}
+
+
+def test_unsupported_is_preserved_even_with_reader():
+    record = {"rects": [rect(0, reader=attempt("R1", .99))]}
+    baseline = {"plate": None, "confidence": 0, "status": "UNSUPPORTED"}
+    assert apply_rule(record, baseline, "max_reader")["status"] == "UNSUPPORTED"
+    assert apply_rule(record, baseline, "max_reader")["plate"] is None
+
+
+def test_first_candidate_reader_is_distinct_from_late_candidate_max():
+    record = {"rects": [rect(1, reader=attempt("late", .99)),
+                        rect(0, reader=attempt("first-candidate", .55))]}
+    assert select_reader(record, "first_candidate_reader")["plate"] == "first-candidate"
+    assert select_reader(record, "max_reader")["plate"] == "late"
+
+
+def test_same_rect_agreement_supports_but_does_not_raise_status():
+    record = {"rects": [rect(0, seg=attempt("pair", .6), reader=attempt("pair", .7)),
+                        rect(1, reader=attempt("solo", .95))]}
+    baseline = {"plate": "wrong", "confidence": .3, "status": "LOW_CONFIDENCE"}
+    result = apply_rule(record, baseline, "agreement_then_reader")
+    assert result["plate"] == "pair"
+    assert result["confidence"] == .6
+    assert result["status"] == "LOW_CONFIDENCE"
+    assert "not calibrated probability" in result["confidence_note"]
+
+
+def test_selection_does_not_depend_on_truth():
+    record = {"truth": "first", "rects": [rect(0, reader=attempt("first", .6)),
+                                               rect(2, reader=attempt("second", .8))]}
+    before = compare_record(record, PARAMS)
+    record["truth"] = "second"
+    after = compare_record(record, PARAMS)
+    assert before == after
+
+
+def test_group_scoring_rescues_and_regressions():
+    rows = [
+        {"truth": "T", "split": "val", "subset": "ccpd_green", "metadata": {"brightness": 10},
+         "results": {"baseline": {"plate": "X", "status": "LOW_CONFIDENCE"},
+                     "max_reader": {"plate": "T", "status": "LOW_CONFIDENCE", "changed": True}}},
+        {"truth": "T", "split": "hard", "subset": "ccpd_db", "metadata": {"brightness": 18},
+         "results": {"baseline": {"plate": "T", "status": "LOW_CONFIDENCE"},
+                     "max_reader": {"plate": "X", "status": "LOW_CONFIDENCE", "changed": True}}},
+    ]
+    result = score(rows, "max_reader")
+    assert result["all"]["rescued_non_ok"] == 1
+    assert result["all"]["regressed_non_ok"] == 1
+    assert result["valgreen"]["n"] == 1
+    assert result["db_brightness_le_19"]["n"] == 1
+    assert result["all"]["auto_pass"] == 0
+    assert result["all"]["whole_plate_correct"] == 1
+
+
+def test_new_identity_schema_is_accepted_without_posthoc_migration():
+    assert _identity_verified({"verified": True})
+    assert _identity_verified({"audit": {"verified": True}})
+    assert _identity_verified({"identity_migration": {"verified": True}})
+    assert not _identity_verified({})
+
+
+def test_non_rescuable_count_is_reported_for_baseline_too():
+    row = {"truth": "T", "split": "val", "subset": "ccpd_base", "metadata": {},
+           "results": {"baseline": {"plate": None, "status": "UNSUPPORTED"},
+                       "max_reader": {"plate": None, "status": "UNSUPPORTED"}}}
+    assert score([row], "baseline")["all"]["cannot_pure_fallback_rescue"] == 1
+    assert score([row], "max_reader")["all"]["cannot_pure_fallback_rescue"] == 1
+
+
+def test_params_reject_nonfinite_bool_and_unknown_prefer():
+    with pytest.raises(ValueError):
+        validate_params({**PARAMS, "agree_min": float("nan")})
+    with pytest.raises(ValueError):
+        validate_params({**PARAMS, "solo_seg": True})
+    with pytest.raises(ValueError):
+        validate_params({**PARAMS, "prefer": "oracle"})
diff --git a/algorithm/tests/test_eval_network_attribution.py b/algorithm/tests/test_eval_network_attribution.py
new file mode 100644
index 0000000..5e436de
--- /dev/null
+++ b/algorithm/tests/test_eval_network_attribution.py
@@ -0,0 +1,142 @@
+from types import SimpleNamespace
+
+import numpy as np
+
+from lpr import pipeline
+from lpr.config import load_config
+from lpr.errors import failure_result
+from lpr.pipeline import _Attempt
+from lpr.types import DecodeResult, PlateCandidate, RectifiedPlate, RecogStatus as S, SegmentResult
+from lpr_tools.data.manifest import ManifestRow, write_manifest
+from lpr_tools.eval.common import AttributedPlateRecognizer
+import lpr_tools.eval.eval_accuracy as eval_accuracy
+
+
+def test_reader_invoked_but_not_selected_when_classic_candidate_wins(monkeypatch):
+    image = np.zeros((100, 200, 3), np.uint8)
+    net = PlateCandidate([(0, 0), (80, 0), (80, 30), (0, 30)], (0, 0, 80, 30), "blue", .9, "net")
+    classic = PlateCandidate([(90, 0), (190, 0), (190, 30), (90, 30)], (90, 0, 100, 30), "blue", .8, "color")
+    monkeypatch.setattr(pipeline, "preprocess", lambda *_: SimpleNamespace())
+    monkeypatch.setattr(pipeline, "locate", lambda *_: [classic])
+    monkeypatch.setattr(pipeline, "_rectifications", lambda _i, c, _cfg: [
+        RectifiedPlate(np.zeros((2, 2, 3), np.uint8), 7, "blue", np.eye(3), c)])
+    monkeypatch.setattr(pipeline, "segment", lambda *_: SegmentResult(False, 7, [], np.zeros((7, 2, 2), np.uint8), 0.))
+    # The reader produces no valid decode, while the conventional path later succeeds.
+    monkeypatch.setattr(pipeline, "_decode_text", lambda *_: None)
+    # Inject a net candidate before the traditional candidate; its reader is called,
+    # then the traditional candidate produces an OK result and wins final selection.
+    class Corner:
+        version = "corner-test"
+        def detect(self, *_): return [net]
+    class Reader:
+        version = "reader-test"
+        def __init__(self): self.calls = 0
+        def read(self, *_): self.calls += 1; return "", []
+    def rects(_i, c, _cfg):
+        return [RectifiedPlate(np.zeros((2, 2, 3), np.uint8), 7, "blue", np.eye(3), c)]
+    monkeypatch.setattr(pipeline, "_rectifications", rects)
+    monkeypatch.setattr(pipeline, "segment", lambda r, *_: SegmentResult(
+        r.candidate.source == "color", 7, [], np.zeros((7, 2, 2), np.uint8), 1.))
+    monkeypatch.setattr(pipeline, "decode", lambda *_: DecodeResult(S.OK, "京A12345", 7, "L7", .99, [.99]*7, []))
+    # _decode_text remains None, so the reader invocation on the net candidate is not selected.
+    cfg = load_config(postprocess__arbitration="first_ok")    # 本测试针对旧规则：分割路线先出 OK 即返回
+    reader = Reader()
+    base = pipeline.PlateRecognizer(cfg, SimpleNamespace(version="fake", predict_proba=lambda _: None),
+                                    corner_detector=Corner(), plate_reader=reader)
+    recognizer = AttributedPlateRecognizer(base)
+    result = recognizer.recognize(image)
+    assert reader.calls == 1
+    assert recognizer.reader_invoked_calls == 1
+    assert recognizer.corner_invoked_calls == 1
+    assert "corner" in result.stage_ms and "reader" in result.stage_ms
+    assert recognizer.last_selection == {"source": "color", "crnn_selected": False}
+    assert result.plate_no == "京A12345"
+
+
+def test_final_reader_attempt_is_reported_as_crnn_selected():
+    candidate = PlateCandidate([(0, 0), (80, 0), (80, 30), (0, 30)],
+                               (0, 0, 80, 30), "blue", .9, "color")
+    rect = RectifiedPlate(np.zeros((2, 2, 3), np.uint8), 7, "blue", np.eye(3), candidate)
+    decode = DecodeResult(S.OK, "京A12345", 7, "L7", .99, [.99] * 7, [])
+    attempt = _Attempt(decode, rect, None)
+    base = pipeline.PlateRecognizer(load_config(), SimpleNamespace(version="fake", predict_proba=lambda _: None))
+    recognizer = AttributedPlateRecognizer(base)
+    result = recognizer._build(attempt, None)
+    assert result.plate_no == "京A12345"
+    assert recognizer.last_selection == {"source": "color", "crnn_selected": True}
+
+
+def test_reader_selected_from_pipeline_after_corner_candidate(monkeypatch):
+    image = np.zeros((100, 200, 3), np.uint8)
+    net = PlateCandidate([(0, 0), (80, 0), (80, 30), (0, 30)], (0, 0, 80, 30), "blue", .9, "net")
+    monkeypatch.setattr(pipeline, "preprocess", lambda *_: SimpleNamespace())
+    monkeypatch.setattr(pipeline, "locate", lambda *_: [])
+    monkeypatch.setattr(pipeline, "_rectifications", lambda _i, c, _cfg: [
+        RectifiedPlate(np.zeros((2, 2, 3), np.uint8), 7, "blue", np.eye(3), c)])
+    monkeypatch.setattr(pipeline, "segment", lambda *_: SegmentResult(False, 7, [], np.zeros((7, 2, 2), np.uint8), 0.))
+    monkeypatch.setattr(pipeline, "_decode_text", lambda *_: DecodeResult(
+        S.OK, "京A12345", 7, "L7", .99, [.99] * 7, []))
+    class Corner:
+        version = "corner-test"
+        def detect(self, *_): return [net]
+    class Reader:
+        version = "reader-test"
+        def read(self, *_): return "京A12345", [.99] * 7
+    base = pipeline.PlateRecognizer(load_config(), SimpleNamespace(version="fake", predict_proba=lambda _: None),
+                                    corner_detector=Corner(), plate_reader=Reader())
+    recognizer = AttributedPlateRecognizer(base)
+    result = recognizer.recognize(image)
+    assert result.plate_no == "京A12345"
+    assert recognizer.last_selection == {"source": "net", "crnn_selected": True}
+    assert recognizer.reader_invoked_calls == recognizer.corner_invoked_calls == 1
+
+
+def test_no_output_does_not_leave_selection_from_previous_result(monkeypatch):
+    candidate = PlateCandidate([(0, 0), (80, 0), (80, 30), (0, 30)],
+                               (0, 0, 80, 30), "blue", .9, "net")
+    rect = RectifiedPlate(np.zeros((2, 2, 3), np.uint8), 7, "blue", np.eye(3), candidate)
+    decoded = DecodeResult(S.OK, "京A12345", 7, "L7", .99, [.99] * 7, [])
+    base = pipeline.PlateRecognizer(load_config(), SimpleNamespace(version="fake", predict_proba=lambda _: None))
+    recognizer = AttributedPlateRecognizer(base)
+    recognizer._build(_Attempt(decoded, rect, None), None)
+    assert recognizer.last_selection is not None
+    monkeypatch.setattr(pipeline, "preprocess", lambda *_: (_ for _ in ()).throw(ValueError("bad")))
+    result = recognizer.recognize(np.zeros((20, 20, 3), np.uint8))
+    assert result.status == S.INTERNAL_ERROR
+    assert recognizer.last_selection is None
+
+
+def test_oracle_row_does_not_recount_previous_np_network_calls(tmp_path, monkeypatch):
+    manifest = tmp_path / "rows.csv"
+    write_manifest(manifest, [
+        ManifestRow("np.png", "", "unknown", "np", "test"),
+        ManifestRow("plate.png", "京A12345", "blue", "clear", "test",
+                    ((0, 0), (100, 0), (100, 40), (0, 40))),
+    ])
+    monkeypatch.setattr(eval_accuracy, "decode_image", lambda *_: (np.zeros((50, 120, 3), np.uint8), None))
+    monkeypatch.setattr(eval_accuracy.OracleRecognizer, "recognize",
+                        lambda *_: failure_result(S.NO_PLATE))
+    class StubRecognizer:
+        version = "stub"
+        config = load_config()
+        classifier = object()
+        last_selection = None
+        reader_invoked_calls = 0
+        corner_invoked_calls = 0
+        def _reset_observation(self):
+            self.last_selection = None
+            self.reader_invoked_calls = self.corner_invoked_calls = 0
+        def recognize(self, _image):
+            self.reader_invoked_calls = self.corner_invoked_calls = 1
+            self.last_selection = {"source": "net", "crnn_selected": True}
+            result = failure_result(S.LOW_CONFIDENCE, stage_ms={"reader": 1., "corner": 1.})
+            result.plate_no = "京A12345"  # actual pipeline result for this np row is a false positive
+            return result
+    report = eval_accuracy.evaluate(manifest, StubRecognizer(), tmp_path / "out", oracle=True)
+    attribution = report["network_attribution"]
+    assert attribution["reader_invoked_images"] == attribution["corner_invoked_images"] == 1
+    assert attribution["reader_invoked_calls"] == attribution["corner_invoked_calls"] == 1
+
+    assert attribution["selected_result_count"] == 1
+    assert attribution["network_candidate_selected_count"] == attribution["crnn_selected_count"] == 1
+    assert attribution["crnn_selected_correct"] == 0 and attribution["crnn_selected_accuracy"] == 0.
diff --git a/algorithm/tests/test_eval_route_features.py b/algorithm/tests/test_eval_route_features.py
new file mode 100644
index 0000000..b3a56a5
--- /dev/null
+++ b/algorithm/tests/test_eval_route_features.py
@@ -0,0 +1,70 @@
+import pytest
+
+from lpr_tools.eval.route_features import (
+    _box_gray_mean,
+    _candidate_agrees,
+    _layout_lengths,
+    _tilt_angle_deg,
+    _validate_identity,
+)
+
+
+def test_tilt_is_mean_absolute_top_and_bottom_edge_angles():
+    assert _tilt_angle_deg([(0, 0), (10, 0), (10, 5), (0, 5)]) == 0
+    assert _tilt_angle_deg([(0, 0), (10, 2), (10, 7), (0, 5)]) == pytest.approx(
+        11.309932474
+    )
+
+
+def test_candidate_identity_requires_count_index_bbox_source_and_score():
+    class Candidate:
+        source = "corner_net"
+        bbox = (1, 2, 30, 12)
+        score = 0.875
+
+    _candidate_agrees(Candidate(), {"0": {
+        "candidate_index": 0, "source": "corner_net", "bbox": [1, 2, 30, 12],
+        "score": 0.875,
+    }}, 0)
+    with pytest.raises(ValueError, match="bbox mismatch"):
+        _candidate_agrees(Candidate(), {"0": {
+            "candidate_index": 0, "source": "corner_net", "bbox": [1, 2, 31, 12],
+            "score": 0.875,
+        }}, 0)
+
+
+def test_layout_inference_uses_only_valid_attempt_prediction_lengths():
+    row = {"rects": [
+        {"candidate_index": 0, "segment": {"valid": True, "plate": "ABCDEFG"},
+         "reader": {"valid": True, "plate": "ABCDEFGH"}},
+        {"candidate_index": 0, "segment": {"valid": False, "plate": "BAD"}},
+        {"candidate_index": 1, "reader": {"valid": True, "plate": "12345678"}},
+    ]}
+    assert _layout_lengths(row, 0) == [7, 8]
+    assert _layout_lengths(row, 1) == [8]
+
+
+def test_box_gray_mean_clips_bbox_and_returns_none_for_empty_intersection():
+    import numpy as np
+
+    gray = np.arange(20, dtype=np.uint8).reshape(4, 5)
+    assert _box_gray_mean(gray, (-2, 1, 4, 2)) == pytest.approx(float(gray[1:3, 0:2].mean()))
+    assert _box_gray_mean(gray, (8, 8, 2, 2)) is None
+
+
+def test_identity_validation_fails_early_for_model_or_locator_config_mismatch():
+    trace_meta = {
+        "schema": "three-route-live-v1",
+        "models": {"detector": {"sha256": "expected-model-sha"}},
+        "config": {"effective_config": {
+            "preprocess": {"scale": 1}, "locate": {"threshold": 2},
+            "lanes": {"main": {}}, "runtime": {"max_candidates": 3},
+        }},
+    }
+    actual = {"effective_config": trace_meta["config"]["effective_config"]}
+    with pytest.raises(ValueError, match="detector model SHA"):
+        _validate_identity(trace_meta, {"sha256": "different-model"}, actual)
+    with pytest.raises(ValueError, match="preprocess"):
+        _validate_identity(trace_meta, {"sha256": "expected-model-sha"}, {
+            "effective_config": {**actual["effective_config"], "preprocess": {"scale": 2}}
+        })
