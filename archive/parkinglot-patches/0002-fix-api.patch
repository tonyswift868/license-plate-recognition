-        logger.warning("抓拍图解码失败，忽略")
+        logger.warning("抓拍图解码失败")
+        return b""
+
+
+def save_capture(image_base64: str | None, *, lane_id: int, plate_no: str) -> str | None:
+    """保存 base64 抓拍图，返回相对路径（入库用）；无有效字节返回 None。"""
+    raw = decode_capture(image_base64)
+    if not raw:
         return None
 
     day = datetime.now().strftime("%Y%m%d")
