diff --git a/backend/app/services/recognition/client.py b/backend/app/services/recognition/client.py
index 1d83752..86982fd 100644
--- a/backend/app/services/recognition/client.py
+++ b/backend/app/services/recognition/client.py
@@ -1,44 +1,44 @@
 """识别服务客户端：业务层唯一入口（M2 ↔ M3 的边界）。
 
 - 优先调用 algorithm/lpr/pipeline.recognize()
-- 算法未实现（NotImplementedError）或未安装依赖时，退回占位识别，保证联调与演示不卡住
+- 给了车牌直接使用；无图才占位；有图识别失败必须转人工
 
 Owner: tonyswift868（算法）/ 刘一凡（调用方）｜任务: F3-T06
 """
 from __future__ import annotations
 
 import logging
+import sys
 import time
-from typing import Optional
 
+from app.core.config import REPO_DIR
 from app.schemas.recognition import RecognitionResult
 
+if str(REPO_DIR) not in sys.path:
+    sys.path.append(str(REPO_DIR))
+
 logger = logging.getLogger("parking.recognition")
 
 MOCK_PLATE = "鲁B12345"
 
 
-def recognize(image_bytes: Optional[bytes] = None, *, hint_plate: Optional[str] = None,
+def recognize(image_bytes: bytes | None = None, *, hint_plate: str | None = None,
               lane_hint: str = "") -> RecognitionResult:
     """识别一张抓拍图，返回统一结构（见 schemas/recognition.py）。"""
     started = time.perf_counter()
+    if hint_plate or image_bytes is None:
+        elapsed = int((time.perf_counter() - started) * 1000)
+        plate = (hint_plate or MOCK_PLATE).upper()
+        return RecognitionResult(plate_no=plate, confidence=0.99, success=True,
+                                 message=f"手动车牌（lane={lane_hint}）" if hint_plate else f"占位识别（lane={lane_hint}）",
+                                 stage_ms={"manual" if hint_plate else "mock": elapsed})
     try:
         from algorithm.lpr.pipeline import recognize as real_recognize  # type: ignore
 
-        result = real_recognize(image_bytes)
+        result = real_recognize(image_bytes, lane_id=int(lane_hint) if lane_hint else None)
         if isinstance(result, dict):
             result = RecognitionResult(**result)
         return result
-    except NotImplementedError:
-        logger.warning("算法流水线尚未实现，使用占位识别结果（F3-T02—F3-T04）")
-    except ImportError:
-        logger.warning("未找到 algorithm 包，使用占位识别结果")
     except Exception as exc:  # noqa: BLE001 - 算法异常不应击穿业务
         logger.exception("识别失败：%s", exc)
         return RecognitionResult(plate_no="", success=False, message="识别失败")
-
-    elapsed = int((time.perf_counter() - started) * 1000)
-    plate = (hint_plate or MOCK_PLATE).upper()
-    return RecognitionResult(plate_no=plate, confidence=0.99, success=True,
-                             message=f"占位识别（lane={lane_hint}）",
-                             stage_ms={"mock": elapsed})
