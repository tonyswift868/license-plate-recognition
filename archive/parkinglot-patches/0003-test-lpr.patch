+"""默认模型的客户端与入场 HTTP 集成；金样例随仓库分发。"""
+from __future__ import annotations
+
+import base64
+from pathlib import Path
+
+import pytest
+
+pytest.importorskip("torch")
+
+from app.services.recognition.client import recognize  # noqa: E402
+
+GOLDEN_NAME = "ccpd2019_ccpd_base_0110201149425-92_87-285&529_479&589-485&598_279&587_277&524_483&535-0_0_5_24_17_33_33-105-19.jpg"
+GOLDEN_PLATE = "皖AF0T99"
+
+
+def test_real_client_and_entry_capture(client):
+    image = (Path(__file__).resolve().parents[1] / "algorithm/tests/data/golden" / GOLDEN_NAME).read_bytes()
+    result = recognize(image, lane_hint="1")
+    assert result.success and result.plate_no == GOLDEN_PLATE
+    response = client.post("/api/v1/entry/capture", json={"lane_id": 1, "image_base64": base64.b64encode(image).decode()})
+    assert response.status_code == 200, response.text
+    assert response.json()["code"] == 0 and response.json()["data"]["plate_no"] == GOLDEN_PLATE
+    bad = client.post("/api/v1/entry/capture", json={"lane_id": 1, "image_base64": "a"})
+    assert bad.status_code == 422 and bad.json()["code"] == 3001
