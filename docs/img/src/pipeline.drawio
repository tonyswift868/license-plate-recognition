<mxfile host="app.diagrams.net" modified="2026-10-28T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="pipeline-m2" name="图5 车牌识别六阶段流水线">
    <mxGraphModel dx="1950" dy="3160" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="3160" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="图 5｜车牌识别六阶段流水线：当前默认 011 + T20_A" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#17324D;fillColor=#EAF4FF;strokeColor=#5B9BD5;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="120" y="20" width="1670" height="65" />
        </mxCell>
        <mxCell id="input" value="输入：原始抓拍图（BGR uint8）及车道 ROI&#10;同车多帧：每帧先独立执行本流程" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#EAF4FF;strokeColor=#5B9BD5;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="520" y="120" width="460" height="75" />
        </mxCell>
        <mxCell id="preprocess" value="① 预处理&#10;输入校验 → ROI / 工作图 → CLAHE 灰度与 HSV&#10;保留原图与工作图坐标映射" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#EAF4FF;strokeColor=#5B9BD5;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="235" width="500" height="105" />
        </mxCell>
        <mxCell id="detector" value="② 网络定位 plate_det_v1&#10;原图 → 中心 / bbox / 四角点预测&#10;按候选中心过滤 ROI" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#EAF4FF;strokeColor=#5B9BD5;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="200" y="390" width="500" height="110" />
        </mxCell>
        <mxCell id="classic" value="② 传统 locate&#10;工作图颜色 / Sobel 边缘 → 几何候选&#10;坐标映回原图" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#EAF4FF;strokeColor=#5B9BD5;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="390" width="500" height="110" />
        </mxCell>
        <mxCell id="merge" value="② 候选融合&#10;网络在前、传统补位，重叠去重，最多三个&#10;当前默认仍保留传统融合" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#EAF4FF;strokeColor=#5B9BD5;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="550" width="500" height="100" />
        </mxCell>
        <mxCell id="has_candidate" value="融合后有候选？" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#FFF4D9;strokeColor=#D6A23A;align=center;verticalAlign=middle;spacing=12;shape=rhombus;perimeter=rhombusPerimeter;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="690" width="280" height="100" />
        </mxCell>
        <mxCell id="no_plate" value="NO_PLATE&#10;定位无候选" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#FDEEEE;strokeColor=#D97A7A;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1120" y="700" width="430" height="80" />
        </mxCell>
        <mxCell id="candidate" value="按融合顺序取当前候选&#10;不跨候选投票" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#EAF4FF;strokeColor=#5B9BD5;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="830" width="500" height="85" />
        </mxCell>
        <mxCell id="rectify" value="③ 校正&#10;原图 + 当前候选 → 有序透视视图&#10;首视图及替代视图供 S / R" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#EAF4FF;strokeColor=#5B9BD5;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="955" width="500" height="105" />
        </mxCell>
        <mxCell id="box" value="③ / ⑤ 原框读牌 B&#10;原 bbox → crop_box（pad 从权重读）&#10;box_reader_v2：每候选一次，缓存跨视图复用" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#EAF4FF;strokeColor=#5B9BD5;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="1100" width="500" height="115" />
        </mxCell>
        <mxCell id="view" value="按原顺序取当前校正视图" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#EAF4FF;strokeColor=#5B9BD5;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="1255" width="500" height="80" />
        </mxCell>
        <mxCell id="segment" value="④ / ⑤ 分割 + CNN：S&#10;校正图 → 版式尝试 → 字符分割 → char_cnn_v2&#10;S 自身首 OK 只结束版式循环，不直接返回系统 OK" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#EAF4FF;strokeColor=#5B9BD5;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="160" y="1380" width="500" height="135" />
        </mxCell>
        <mxCell id="reader" value="⑤ 校正 CRNN：R&#10;同一校正图 → crnn_v2&#10;即使 S 分割失败也继续读取" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#EAF4FF;strokeColor=#5B9BD5;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="840" y="1380" width="500" height="135" />
        </mxCell>
        <mxCell id="auto" value="⑥ 011 自动判定（同候选、同校正视图）&#10;合法同串 S/R → S/B → R/B&#10;再 S-solo → R-solo；首个自动事件即返回" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#FFF4D9;strokeColor=#D6A23A;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="1570" width="500" height="145" />
        </mxCell>
        <mxCell id="ok" value="OK：自动通过，立即返回&#10;停止后续视图 / 候选推理&#10;仍须业务校验才能放行" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#E9F5EC;strokeColor=#60A879;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="1595" width="470" height="100" />
        </mxCell>
        <mxCell id="more_views" value="该候选还有校正视图？" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#FFF4D9;strokeColor=#D6A23A;align=center;verticalAlign=middle;spacing=12;shape=rhombus;perimeter=rhombusPerimeter;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="1770" width="280" height="105" />
        </mxCell>
        <mxCell id="box_solo" value="⑥ B-solo&#10;仅该候选全部校正视图结束后检查&#10;不可提前到首视图之前" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#FFF4D9;strokeColor=#D6A23A;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="1930" width="500" height="105" />
        </mxCell>
        <mxCell id="more_candidates" value="还有候选？" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#FFF4D9;strokeColor=#D6A23A;align=center;verticalAlign=middle;spacing=12;shape=rhombus;perimeter=rhombusPerimeter;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="2085" width="280" height="100" />
        </mxCell>
        <mxCell id="special" value="未自动通过且候选0&#10;首视图为白 / 黑？" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#FFF4D9;strokeColor=#D6A23A;align=center;verticalAlign=middle;spacing=12;shape=rhombus;perimeter=rhombusPerimeter;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="2235" width="280" height="110" />
        </mxCell>
        <mxCell id="unsupported" value="UNSUPPORTED&#10;特种牌转人工" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#FDEEEE;strokeColor=#D97A7A;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="2250" width="470" height="80" />
        </mxCell>
        <mxCell id="fallback" value="⑥ T20_A 人工回退&#10;仅用候选0预测四角角度：达门槛偏好 A，否则 M&#10;再按 [preferred,A,M,L] 取首个合法读法&#10;合法 → LOW_CONFIDENCE；无读法 → INVALID_FORMAT / SEG_FAILED" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#EAF4FF;strokeColor=#5B9BD5;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="2390" width="500" height="150" />
        </mxCell>
        <mxCell id="result" value="单帧 RecognitionResult&#10;状态 / 文本 / 置信度 / 原图几何 / 图像证据&#10;to_dict() 不包含 ndarray 或新增仲裁诊断字段" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#E9F5EC;strokeColor=#60A879;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="2590" width="500" height="110" />
        </mxCell>
        <mxCell id="voting" value="调用方可选：同车多帧投票&#10;recognize_many / PlateVoteSession&#10;不同车辆不可混入同一会话" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#F2ECFA;strokeColor=#9878C5;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="2750" width="500" height="110" />
        </mxCell>
        <mxCell id="dedup" value="调用方可选：DuplicateFilter&#10;重复抓拍提示不替代 M3/M5 事务幂等" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#F2ECFA;strokeColor=#9878C5;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="2910" width="500" height="90" />
        </mxCell>
        <mxCell id="errors" value="输入或解码无效 → BAD_INPUT&#10;运行期非预期异常 → INTERNAL_ERROR&#10;这些失败也封装为 RecognitionResult" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#FDEEEE;strokeColor=#D97A7A;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="2400" width="380" height="135" />
        </mxCell>
        <mxCell id="identity" value="身份约束&#10;S/R 固定 (candidate,rect)&#10;B 固定 candidate，原框读取一次&#10;不读 GT；不按识别真值挑校正视图" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#F6F8FA;strokeColor=#ADB5BD;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1370" y="840" width="450" height="170" />
        </mxCell>
        <mxCell id="thresholds" value="完整阈值见正文 3.9.1&#10;agree 与单路门槛各自独立&#10;比较含等号、不截断浮点&#10;人工回退不可升级为自动 OK" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#F6F8FA;strokeColor=#ADB5BD;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1370" y="1070" width="450" height="170" />
        </mxCell>
        <mxCell id="export" value="当前默认来源：algorithm/config/default.toml；仲裁合同：03-三路仲裁集成规格.md §7；节点对应正文 §3.3。&#10;旧流程仅用 config/legacy_agree_v1.toml 留档。用户导出本页为 docs/img/pipeline.png。" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#17324D;fillColor=#F6F8FA;strokeColor=#ADB5BD;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=10;" vertex="1" parent="1">
